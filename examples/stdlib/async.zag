## stdlib/async.zag — std.async (lib/std/async/): timer-driven
## event loop written entirely in zag.
##
##   import std.async.{EventLoop, sleep, now_ms}
##
##   var loop: EventLoop = EventLoop.new();
##   var t1: Future<void> = undefined;
##   loop.set_timeout(50, &t1);   # &t1 is a *Future<void> — the
##                                # loop's API takes *raw u8, so
##                                # pass `&t1 as *raw u8`.
##   loop.wait(&t1, 500);         # drive until t1 is done or timeout
##   await t1;
##
## The loop stores the caller's Future pointer, polls it against
## CLOCK_MONOTONIC deadlines between 1ms nanosleep ticks (no
## busy-wait), and flips `.done` when the deadline passes. wait()
## returns true when the future completed in time.

import std.async.{EventLoop, sleep, now_ms}

fun main() {
    var loop: EventLoop = EventLoop.new();
    let start: i64 = now_ms();
    var t1: Future<void> = undefined;
    var t2: Future<void> = undefined;
    loop.set_timeout(30, &t1 as *raw u8);
    loop.set_timeout(80, &t2 as *raw u8);
    let ok1: bool = loop.wait(&t2 as *raw u8, 500);
    let elapsed: i64 = now_ms() - start;
    let t1done: bool = t1.done;
    let t2done: bool = t2.done;
    print("waited {elapsed}ms ok={ok1} t1done={t1done} t2done={t2done}\n");
    # await unwraps the already-completed future in the v1 eager model.
    await t2;
}
