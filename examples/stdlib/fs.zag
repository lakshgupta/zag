## stdlib/fs.zag — whole-file read usage example.
##
## Reads a small known file and prints its byte count. The exact
## file is `examples/basics/hello.zag` — a tiny source file with
## predictable content (assert its size is stable across zag
## revisions so the smoke run's expected-output pin holds).
##
## One-spelling contract (the `!` collapse):
## - `read_file(path) -> Result(String, Error)` is the ONLY whole-file
##   reader; it never panics on IO failure. The caller chooses the
##   failure policy at the CALL SITE:
##   - `read_file(path)!`   → panic on failure (the fail-fast form)
##   - `read_file(path)?`   → propagate the Err to the caller
##   - `match read_file(p)` → branch on NotFound vs Permission vs Io
##   docs/manual/19 documents `!` as the panicking mirror of `?`. There
##   is no separate panicking spelling: `read_file(p)!` IS that spelling.
## - `String.as_str(self: *String) -> []const u8` returns a slice
##   over the heap-owned buffer; `.len` on it is the byte count.
## - Heap ownership: the returned `String`'s buffer is page-allocator
##   backed; lifecycle is process-exit-reclaim today.
##
## Imports contract: BOTH std.fs.{read_file} (the impl) AND
## std.types.{String} (the return type) must be visible at the
## fixture's top — the imports-loop in src/codegen/core.zig bridges
## @import("lib/std/...") + per-selector aliases only on explicit
## `import` lines in user source. The `lib/std` namespace is NOT
## ambient in fixture files.

import std.fs.{read_file};
import std.types.{String};

fun main() {
    # Harness contract (examples/run_all.sh): every fixture runs with
    # CWD = repo root, so the anchor path is repo-root-relative.
    # `!` unwraps the Ok and panics on Err — the fail-fast spelling.
    let data: String = read_file("examples/basics/hello.zag")!;
    print("read {data.as_str().len} bytes\n");
}
