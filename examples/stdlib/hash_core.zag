## stdlib/hash_core.zag — pure-.zag stdlib batch: sort, encoding,
## hash, random (lib/std/sort.zag, encoding.zag, hash.zag,
## random.zag).
##
##   import std.sort.{sort, binary_search}
##   import std.encoding.{base64_encode, hex_encode}
##   import std.hash.{fnv1a32, crc32, sha256}
##   import std.random.{XorShift64Star}
##
## Verified against known test vectors:
##   - fnv1a32("hello")        == 0x4F9F2CAB
##   - crc32("123456789")      == 0xCBF43926 (IEEE check value)
##   - sha256("abc")[0..3]     == 0xBA 0x78 0x16
##   - base64("hello")         == "aGVsbG8="
##
## The encode/decode helpers return heap slices — the caller owns
## them and must `free` (the escape analyzer warns on leaks).
## Hash functions are pure and return digests by value.

import std.sort.{sort, binary_search}
import std.encoding.{base64_encode, hex_encode}
import std.hash.{fnv1a32, crc32, sha256}
import std.random.{XorShift64Star}

fun main() {
    var arr: [5]i32 = { 5, 2, 4, 1, 3 };
    sort<i32>(arr[0..]);
    print("sorted: {arr[0]} {arr[1]} {arr[2]} {arr[3]} {arr[4]}\n");
    let idx: ?usize = binary_search<i32>(arr[0..], 4);
    print("found 4 at {idx}\n");

    let b64: []u8 = base64_encode("hello");
    defer free(b64);
    print("b64: {b64}\n");

    let hx: []u8 = hex_encode("AB");
    defer free(hx);
    print("hex: {hx}\n");

    let f: u32 = fnv1a32("hello");
    print("fnv1a32: {f}\n");
    let c: u32 = crc32("123456789");
    print("crc32: {c}\n");
    let d: [32]u8 = sha256("abc");
    print("sha256 head: {d[0]} {d[1]} {d[2]}\n");

    var rng: XorShift64Star = XorShift64Star.seed_from(1);
    print("rng: {rng.next_u64()} {rng.next_f64()}\n");
}
