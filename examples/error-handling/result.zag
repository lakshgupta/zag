## Error handling with Result, Option, and ?
##
## Run: zag run result.zag
##
## v1→v2 migration: `Result<T, E>` and `Option<T>` are `union`s in the v2
## taxonomy (they carry payloads and may mix bare and payload variants).
## The v1 compiler parses `union X { ... }` via the `enum` keyword pending
## the v2 `union` keyword being wired in, so this file does not declare
## `Result` / `Option` itself — those types are supplied by the standard
## library. Each is written with `union` in docs/manual/14-unions.md and
## docs/manual/18-error-handling.md.

fun divide(a: i32, b: i32) -> Result<i32, str> {
    if b == 0 {
        return Err("division by zero");
    }
    return Ok(a / b);
}

fun maybe_get(index: i32) -> Option<i32> {
    if index < 0 || index >= 3 {
        return None;
    }
    return Some(index * 10);
}

fun main() {
    # Result handling
    match divide(10, 2) {
        Ok(val) => print("10 / 2 = {val}\n"),
        Err(msg) => print("error: {msg}\n"),
    }

    match divide(10, 0) {
        Ok(val) => print("10 / 0 = {val}\n"),
        Err(msg) => print("error: {msg}\n"),
    }

    # Option handling
    match maybe_get(1) {
        Some(val) => print("maybe_get(1) = {val}\n"),
        None      => print("maybe_get(1) = none\n"),
    }
}
