# Pointers chapter — `&x` (address-of), `*p` (deref), and slicing.
#
# This example walks through the pointer surface documented in
# `docs/manual/09-pointers.md`: mutable / const address-of, deref,
# half-open and inclusive slicing, full-array view via `arr[..]`, and
# nullable pointer initialisation. Run it with `zag run examples/memory/pointers.zag`.

fun main() {
    # Address-of: take a mutable pointer to a stack-local variable.
    var counter: i32 = 0;
    let p_mut: *i32 = &counter;

    # Address-of on an immutable binding is still legal in zag; the
    # pointer type is `*const T` once we annotate it explicitly. The
    # emitted zig also infers `*const i32` from the binding's `let`
    # kind, but we annotate for clarity.
    let read_only: i32 = 100;
    let p_const: *const i32 = &read_only;
    print("p_const = {p_const}\n");

    # Deref: read through a pointer.
    let initial: i32 = *p_mut;
    print("initial = {initial}\n");

    # Deref on the LHS of an assignment writes through the pointer.
    *p_mut = 42;
    print("counter = {counter}\n");

    # Slicing: produce a `[]i32` view into an array. Half-open form
    # `arr[a..b]` excludes index `b`; full-array view `arr[..]` covers
    # the entire array; `arr[a..]` runs from `a` to end; `arr[..b]`
    # runs from start to index `b - 1`.
    let data: [5]i32 = { 10, 20, 30, 40, 50 };
    let middle: []const i32 = data[1..4];     # [20, 30, 40]
    let tail: []const i32 = data[3..];        # [40, 50]
    print("tail = {tail[0]} {tail[1]}\n");
    let head: []const i32 = data[..3];        # [10, 20, 30]
    print("head = {head[0]} {head[1]} {head[2]}\n");
    let all:  []const i32 = data[..];         # [10, 20, 30, 40, 50]
    print("all = {all[0]} {all[1]} {all[2]} {all[3]} {all[4]}\n");

    # Inclusive slicing: `arr[a...b]` includes index `b`. Codegen emits
    # the half-open form with `+ 1` adjustment, so `data[1...3]` is
    # equivalent to `data[1..4]` for integer slices.
    #
    # Note on `[]const i32` vs `[]i32`: zig 0.16 returns a sized
    # array-tail pointer (`*const [b-a]i32`) from slicing a const
    # value-type array, not an unsized slice. The binding
    # annotation therefore uses the immutable-slice type `[]const i32`
    # to match the inferred RHS — using `[]i32` here triggers
    # `expected type '[]i32', found '*const [3]i32'` plus a cascade
    # of "unused local constant" diagnostics on every sibling
    # let-binding (the build halts at line 54 before codegen reaches
    # them). Mirrors zig's canonical idiom for slicing immutable data.
    let inclusive: []const i32 = data[1...3]; # [20, 30, 40]
    print("inclusive = {inclusive[0]} {inclusive[1]} {inclusive[2]}\n");

    # Iteration: `for` consumes the slice and yields one element per
    # iteration. Indexing into a slice (`middle[0]`) gives the i-th
    # element.
    print("middle = {middle[0]} {middle[1]} {middle[2]}\n");

    # Nullable pointers: any pointer form can be made nullable by
    # prefixing `?`. Initialise to `null` when no value is ready; bind
    # a real pointer otherwise. Nullable pointer forms are `Copy` — the
    # assignment below duplicates the (possibly null) pointer value.
    # (codegen-decl.zig: `?*T annotation round-trips in let binding`)
    let maybe_ptr: ?*i32 = null;
    var owned_counter: i32 = 7;
    let also_maybe: ?*i32 = &owned_counter;
    print("maybe = {maybe_ptr}\n");
    print("also_maybe = {also_maybe}\n");

    # Nullable immutable pointer (`?*const T`): the same null-or-pointer
    # surface as `?*T`, but the pointee it carries is immutable. The
    # `&counter_r` initializer borrows the value as `*const i32` so
    # the emitted zig matches the user-annotated type without coercion.
    # (codegen-decl.zig: `?*const T annotation round-trips in let binding`)
    var counter_r: i32 = 50;
    let maybe_ro: ?*const i32 = null;
    print("maybe_ro = {maybe_ro}\n");
    let also_ro: ?*const i32 = &counter_r;
    print("also_ro = {also_ro}\n");

    # Nullable raw pointer (`?*raw T`): same null-or-pointer surface
    # applied to a raw C-style pointer. Useful for FFI shims where a
    # callback may return null on error. The `null` initialiser is
    # the natural starting state for a typed raw bind until the FFI
    # call completes. (codegen-decl.zig: `?*raw T annotation round-trips`)
    let maybe_raw: ?*raw u8 = null;
    print("maybe_raw = {maybe_raw}\n");

    # Nullable slice (`?[]const u8`): the same null-or-value surface
    # applied to a slice type. Binds a slice OR null. Used in
    # lib/std/env.zag where `?[]const u8` is the canonical return
    # type for environment lookups that may fail. (codegen-decl.zig:
    # `?[]const u8 annotation round-trips in let binding`)
    let maybe_slice: ?[]const u8 = null;
    print("maybe_slice = {maybe_slice}\n");
    let hello_const: []const u8 = "hello";
    let also_slice: ?[]const u8 = hello_const;
    print("also_slice = {also_slice}\n");

    # Non-nullable immutable annotation (`*const T`): the same
    # surface as `let read_only: i32 = ...` + `&read_only` does
    # automatically, but spelled out as an explicit annotation. Useful
    # when the binding kind is `var` but the pointer is borrowed
    # immutably — e.g. when a function parameter wants the caller's
    # data without copying.
    # (codegen-decl.zig: `*const T annotation round-trips in let binding`)
    var fresh: i32 = 70;
    let fresh_ro: *const i32 = &fresh;
    print("fresh_ro = {fresh_ro}\n");

    # Slice iteration: `for v in slice { ... }` walks the slice in
    # source order, yielding each element as a Copy. Codegen emits
    # `for (slice) |v| { ... }` verbatim so zig's iteration semantics
    # carry through directly. The slice's `len` drives the iteration
    # count; the slice's `ptr` field advances `T`-sized steps.
    # (codegen-decl.zig: `for v in slice { ... }` iter emits verbatim`)
    print("iter middle = ");
    for v in middle {
        print("{v} ");
    }
    print("\n");

    # Indexed assignment to a slice element.
    var scratch: [3]i32 = [3]i32 { 0 ... };
    scratch[0] = 11;
    scratch[1] = 22;
    scratch[2] = 33;
    print("scratch = {scratch[0]} {scratch[1]} {scratch[2]}\n");

    # Raw-pointer arithmetic: `p.add(N)` and `q.offset(p)` are
    # zig-fallback'd by the codegen (see docs/manual/09-pointers.md
    # §"Raw pointers" implementation note) so the parser's regular
    # `.method_call` shape round-trips to zig's @ptrFromInt /
    # @intFromPtr / @sizeOf(@typeInfo(@TypeOf(p)).pointer.child)
    # intrinsics at compile time. The `@typeInfo...pointer.child`
    # strip extracts the POINTE type so `@sizeOf(*raw u8)` becomes
    # `@sizeOf(u8)` = 1 (byte stride) instead of 8 (pointer stride).
    # `unsafe` is a user-side convention only — zag does not enforce
    # any special semantics on its contents.
    var raw_buf: [4]u8 = undefined;
    unsafe {
        let p: *raw u8 = &raw_buf;
        let q: *raw u8 = p.add(2);     # p + 2 * sizeof(u8) = p + 2 bytes
        let n: usize = q.offset(p);    # (q - p) / sizeof(u8) = 2 — `.offset` zig-fallback returns `usize` per zig's `@intFromPtr` intrinsic; annotate the LHS as `usize` to match, or wrap in `as i64` if a signed offset is required.
        print("q.offset(p) = {n}\n");
    }
}

@[test]
fun test_pointer_deref() {
    var counter: i32 = 0;
    let p: *i32 = &counter;
    *p = 7;
    assert(counter == 7);
}

@[test]
fun test_slicing() {
    let data: [5]i32 = { 10, 20, 30, 40, 50 };
    let middle: []const i32 = data[1..4];
    assert(middle[0] == 20);
    assert(middle[2] == 40);
}

@[test]
fun test_nullable_pointer() {
    let maybe_ptr: ?*i32 = null;
    assert(maybe_ptr == null);
    var val: i32 = 99;
    let ptr: ?*i32 = &val;
    assert(ptr != null);
}
