## unsafe block — source-level audit marker
##
## Zag's `unsafe { ... }` block is a SOURCE-LEVEL marker for code
## review and tooling. zig 0.16 already permits raw-pointer deref
## and `@ptrCast` unconditionally, so the block's only effect on
## the emitted zig is to wrap the body in plain `{ ... }` with
## `// unsafe {` and `// }` comment markers. Use it for auditability.
##
## Run: zag run unsafe.zag

import std.mem.{alloc};

fun main() {
    unsafe {
        # Raw pointer arithmetic on `*raw u8` — allowed in zig 0.16
        # unconditionally but the `unsafe { }` marker makes the audit
        # boundary explicit.
        let buf: []u8 = alloc(4);
        let p: *raw u8 = buf.ptr;
        # `*raw u8` is a many-item pointer (`[*]u8`): writes use index
        # syntax (zig rejects unindexed deref on unknown-length
        # pointers). Pointer arithmetic is legal on the raw type.
        p[0] = 'a';
        let adv: *raw u8 = (p + 1) as *raw u8;
        adv[0] = 'b';
        # Free the owning slice (a `*raw`/many-item pointer has no
        # size for destroy — the slice carries the allocation).
        free(buf);
        print("unsafe ops completed\n");
    }
    print("after unsafe block\n");
}

@[test]
fun test_unsafe_block() {
    unsafe {
        let buf: []u8 = alloc(4);
        let p: *raw u8 = buf.ptr;
        p[0] = 'a';
        free(buf);
    }
    assert(true);
}
