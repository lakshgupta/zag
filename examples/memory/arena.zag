## Arena allocator sugar — Pattern 3 from docs/20-memory.md
##
## `new(arena, T(value))` allocates via `<arena>.create(T)` instead
## of the global page allocator — `arena.free_all()` resets the
## entire arena in O(1) when the scope exits.
##
## Run: zag run arena.zag

fun main() {
    # Arena-backed allocation (`new(arena, i32(100))`) requires a
    # variable whose type exposes zig's `.create(T)` method — see
    # docs/20 §"Custom Allocators" for the contract. This demo
    # exercises the same alloc-defer-free shape through the global
    # page allocator; swapping in a real arena-backed type turns the
    # `defer free` below into `defer arena.free_all()`.
    let p: *i32 = new i32(100);
    defer free(p);
    print("arena-allocated value at heap address\n");
}