## Operator overloading — dunder pattern (docs/31)
##
## Operators desugar to specially named methods declared in an `impl`
## block: `a + b` calls `__add__`, `a[i]` calls `__index__`, and so on.
## The compiler picks the method that matches the operands' types, so a
## user type participates in normal operator syntax with zero runtime
## indirection.
##
## Run: zag run operator_overloading.zag

struct Vec2 {
    x: f64,
    y: f64,
}

impl Vec2 {
    pub fun init(x: f64, y: f64) -> Vec2 {
        return Vec2 { x: x, y: y };
    }

    pub fun __add__(a: Vec2, b: Vec2) -> Vec2 {
        return Vec2 { x: a.x + b.x, y: a.y + b.y };
    }

    pub fun __sub__(a: Vec2, b: Vec2) -> Vec2 {
        return Vec2 { x: a.x - b.x, y: a.y - b.y };
    }

    pub fun __mul__(a: Vec2, s: f64) -> Vec2 {
        return Vec2 { x: a.x * s, y: a.y * s };
    }

    pub fun __div__(a: Vec2, s: f64) -> Vec2 {
        return Vec2 { x: a.x / s, y: a.y / s };
    }

    pub fun __neg__(a: Vec2) -> Vec2 {
        return Vec2 { x: -a.x, y: -a.y };
    }

    pub fun __eq__(a: Vec2, b: Vec2) -> bool {
        return a.x == b.x && a.y == b.y;
    }

    pub fun __lt__(a: Vec2, b: Vec2) -> bool {
        return a.x < b.x;
    }

    pub fun __index__(self: *const Vec2, i: usize) -> f64 {
        return match i {
            0 => self.x,
            1 => self.y,
            _ => 0.0,
        };
    }
}

# A mutable aggregate: `__index__` reads, `__index_set__` backs `s[i] = v`.
struct Store {
    slots: [2]i32,
}

impl Store {
    pub fun init() -> Store {
        return Store { slots: { 0, 0 } };
    }

    pub fun __index__(self: *const Store, i: usize) -> i32 {
        return self.slots[i];
    }

    pub fun __index_set__(self: *Store, i: usize, v: i32) {
        self.slots[i] = v;
    }
}

fun main() {
    let a: Vec2 = Vec2.init(4.0, 6.0);
    let b: Vec2 = Vec2.init(1.0, 2.0);

    let sum: Vec2 = a + b;
    let diff: Vec2 = a - b;
    let scaled: Vec2 = a * 2.0;
    let halved: Vec2 = b / 2.0;
    let negated: Vec2 = -a;
    print("a + b = ({sum.x}, {sum.y})\n");
    print("a - b = ({diff.x}, {diff.y})\n");
    print("a * 2 = ({scaled.x}, {scaled.y})\n");
    print("b / 2 = ({halved.x}, {halved.y})\n");
    print("-a    = ({negated.x}, {negated.y})\n");
    let same: bool = a == b;
    let less: bool = b < a;
    print("a == b: {same}\n");
    print("b < a:  {less}\n");
    print("a[0] = {a[0]}, a[1] = {a[1]}\n");

    var s: Store = Store.init();
    s[0] = 7;
    s[1] = 9;
    print("s[0] = {s[0]}, s[1] = {s[1]}\n");
}

@[test]
fun test_arithmetic_desugars() {
    let a: Vec2 = Vec2.init(4.0, 6.0);
    let b: Vec2 = Vec2.init(1.0, 2.0);
    let sum: Vec2 = a + b;
    assert(sum.x == 5.0 && sum.y == 8.0);
    let diff: Vec2 = a - b;
    assert(diff.x == 3.0 && diff.y == 4.0);
    let scaled: Vec2 = b * 3.0;
    assert(scaled.x == 3.0 && scaled.y == 6.0);
    let negated: Vec2 = -b;
    assert(negated.x == -1.0 && negated.y == -2.0);
}

@[test]
fun test_comparison_and_index() {
    let a: Vec2 = Vec2.init(4.0, 6.0);
    let same: Vec2 = Vec2.init(4.0, 6.0);
    let other: Vec2 = Vec2.init(1.0, 2.0);
    assert(a == same);
    assert(!(a == other));
    assert(other < a);
    assert(a[0] == 4.0);
    assert(a[1] == 6.0);
}

@[test]
fun test_index_set() {
    var s: Store = Store.init();
    s[0] = 7;
    s[1] = 9;
    assert(s[0] == 7);
    assert(s[1] == 9);
}
