# Diamond disambiguation — lopsided (docs/17 §"Dot-qualified methods").
# When two listed traits share a method name (the diamond shape),
# the dot-qualified form `Trait.method` binds each body to the
# named trait's vtable. A trait whose method is NOT qualified
# leaves that slot unfulfilled — a partial impl that a second
# `impl` block may complete.
#
# Here `print` is declared by both Display and Show. Display's
# `print` gets a body; Show's `print` slot stays unfulfilled.
# The `render` method is unique to Show — it could be qualified
# or unqualified (inferred by uniqueness).

trait Display {
    fun print(self: *Self);
}

trait Show {
    fun print(self: *Self);
    fun render(self: *Self);
}

struct Button {
    label: str,
}

impl Button with Display, Show {
    pub fun Display.print(self: *Button) {
        print("[display] ");
        print(self.label);
        print("\n");
    }

    pub fun Show.render(self: *Button) {
        print("[show] ");
        print(self.label);
        print("\n");
    }
}

fun main() {
    let btn: Button = Button { label: "ok" };
    # Display's vtable carries `print`; casting through Display
    # dispatches to Button_Display_print.
    let d: Display = btn as Display;
    d.print();
    # Show's vtable carries `render` only (its `print` slot is
    # unfulfilled — calling it would surface a zig compile error
    # because the vtable entry is missing).
    let s: Show = btn as Show;
    s.render();
}

@[test]
fun test_diamond_lopsided() {
    let btn: Button = Button { label: "test" };
    let d: Display = btn as Display;
    d.print();
    let s: Show = btn as Show;
    s.render();
    assert(true);
}
