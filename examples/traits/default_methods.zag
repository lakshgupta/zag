# Default trait methods (docs/17 §"Default Methods").
# A trait method with a body is a default — the impl block may
# inherit or override it. A method without a body is required.
#
# NOTE: Default trait methods require compiler support that is not
# yet implemented. This example uses only required methods.

trait Logger {
    pub fun log(self: *Self, msg: str);
}

struct Console {}

impl Console with Logger {
    pub fun log(self: *Console, msg: str) {
        print(msg);
    }
}

struct FileLogger {
    file: str,
    level: str,
}

impl FileLogger with Logger {
    pub fun log(self: *FileLogger, msg: str) {
        print(msg);
        print(self.file);
    }
}

fun main() {
    let c: Console = Console {};
    let cl: Logger = c as Logger;
    cl.log("info message");

    let f: FileLogger = FileLogger { file: "log.txt", level: "prod" };
    let fl: Logger = f as Logger;
    fl.log("startup");
}

@[test]
fun test_default_methods_inherited() {
    let c: Console = Console {};
    let cl: Logger = c as Logger;
    cl.log("test log");
}

@[test]
fun test_default_methods_overridden() {
    let f: FileLogger = FileLogger { file: "test.log", level: "dev" };
    let fl: Logger = f as Logger;
    fl.log("test");
}
