# Diamond disambiguation — shared body with a private helper
# (docs/17 §"Dot-qualified methods" + §"Resolving methods").
# When both traits share a method name and both need the same
# body, qualify each with `Trait.method` and factor shared work
# into a module-scope helper. The helper is a regular fn, not a
# trait method — no vtable entry.
#
# The dot-qualified bodies register on Display's and Show's
# vtables respectively. The compiler emits one renamed free fn
# per (target, trait) pair — same body, two fns:
#   Button_Display_print   ← registers on Display's vtable
#   Button_Show_print       ← registers on Show's vtable
#
# Use this when the body is genuinely shared — both traits want
# the same observable behavior for the method.

trait Display {
    fun print(self: *Self);
}

trait Show {
    fun print(self: *Self);
}

struct Button {
    label: str,
}

fn print_button(self: *Button) {
    print(self.label);
    print("\n");
}

impl Button with Display, Show {
    pub fun Display.print(self: *Button) { print_button(self); }
    pub fun Show.print(self: *Button)    { print_button(self); }
}

fun main() {
    let btn: Button = Button { label: "ok" };
    # One body, two vtable entries — both casts dispatch to the
    # same source body via different renamed free fns.
    let d: Display = btn as Display;
    d.print();
    let s: Show = btn as Show;
    s.print();
}

@[test]
fun test_diamond_shared() {
    let btn: Button = Button { label: "test" };
    let d: Display = btn as Display;
    d.print();
    let s: Show = btn as Show;
    s.print();
    assert(true);
}
