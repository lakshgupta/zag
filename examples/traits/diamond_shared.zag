# Diamond disambiguation — shared body (docs/17 §"Diamond Disambiguation").
# When the same method name is parenthesised on EVERY listed trait,
# the single body registers on ALL their vtables. The compiler emits
# one renamed free fn per (target, trait) pair — same body, two fns:
#   Button_Display_print   ← registers on Display's vtable
#   Button_Show_print       ← registers on Show's vtable
#
# Use this when the body is genuinely shared across the diamond (both
# traits want the same observable behavior for the method).

trait Display {
    fun print(self: *Self);
}

trait Show {
    fun print(self: *Self);
}

struct Button {
    label: str,
}

impl Button with Display (print), Show (print) {
    pub fun print(self: *Button) {
        print(self.label);
        print("\n");
    }
}

fun main() {
    let btn: Button = Button { label: "ok" };
    # One body, two vtable entries — both casts dispatch to the
    # SAME source body via different renamed free fns.
    let d: Display = btn as Display;
    d.print<Button>();
    let s: Show = btn as Show;
    s.print<Button>();
}