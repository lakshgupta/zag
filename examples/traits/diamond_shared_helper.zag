# Diamond disambiguation — shared body with a private helper
# (docs/17 §"Dot-qualified methods"). When two traits share a
# method name, qualify each body with `Trait.method` and factor
# shared work into a module-scope helper. The helper is a regular
# fn, not a trait method — no vtable entry. Each qualified body
# calls the helper and registers on its trait's vtable.

trait Display {
    fun print(self: *Self);
}

trait Show {
    fun print(self: *Self);
}

struct Button {
    label: str,
}

# Shared helper: formats the button once; both trait bodies call it.
fun button_format(self: *Button) -> str {
    return self.label;
}

impl Button with Display, Show {
    pub fun Display.print(self: *Button) {
        print("display: ");
        print(button_format(self));
        print("\n");
    }
    pub fun Show.print(self: *Button) {
        print("show: ");
        print(button_format(self));
        print("\n");
    }
}

fun main() {
    let btn: Button = Button { label: "ok" };
    let d: Display = btn as Display;
    d.print();
    let s: Show = btn as Show;
    s.print();
}

@[test]
fun test_diamond_shared_helper() {
    let btn: Button = Button { label: "test" };
    let d: Display = btn as Display;
    d.print();
    let s: Show = btn as Show;
    s.print();
    assert(true);
}
