# Canonical `impl Type with Trait (m) { ... }` demo (docs/17 §"Implementing").
# Demonstrates the design-spec surface for trait implementation:
#   1. trait decl with a required method
#   2. struct decl with a field
#   3. impl block whose `with Trait` header binds the method body to
#      Drawable's vtable via the diamond-disambiguator clause
#   4. cast arm: `btn as Drawable` emitting the fat-pointer container
#   5. dispatch arm: `d.draw()` calling through the vtable
#
# Compared to `basic_draw.zag` (the legacy `pub fun Drawable.draw`
# prefix form), this example uses the canonical surface: the impl
# block names the trait at the header, so the `pub fun draw` body
# dispatches to Drawable's vtable via uniqueness (path (b) of the
# design spec's per-method dispatch rule).

trait Drawable {
    fun draw(self: *Self);
}

struct Button {
    label: str,
}

impl Button with Drawable {
    pub fun draw(self: *Button) {
        print("button: ");
        print(self.label);
        print("\n");
    }
}

fun main() {
    let btn: Button = Button { label: "click me" };
    let d: Drawable = btn as Drawable;
    d.draw();
}

@[test]
fun test_canonical_with_cast() {
    let btn: Button = Button { label: "test" };
    let d: Drawable = btn as Drawable;
    d.draw();
    assert(true);
}