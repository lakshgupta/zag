# Diamond disambiguation — distinct methods per trait
# (docs/17 §"Dot-qualified methods"). When the diamond has each
# trait owning a DIFFERENT method, qualify each body with
# `Trait.method`. The bodies can diverge freely — Display's
# `print` formats one way, Show's `render` another.

trait Display {
    fun print(self: *Self);
}

trait Show {
    fun render(self: *Self);
}

struct Button {
    label: str,
}

impl Button with Display, Show {
    pub fun Display.print(self: *Button) {
        print("[display] ");
        print(self.label);
        print("\n");
    }

    pub fun Show.render(self: *Button) {
        print("[show] ");
        print(self.label);
        print("\n");
    }
}

fun main() {
    let btn: Button = Button { label: "ok" };
    let d: Display = btn as Display;
    d.print();
    let s: Show = btn as Show;
    s.render();
}
