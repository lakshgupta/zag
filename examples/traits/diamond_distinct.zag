# Diamond disambiguation — distinct methods per trait
# (docs/17 §"Diamond Disambiguation"). When the diamond has each
# trait owning a DIFFERENT method, list each under its owning trait
# in the parens. The bodies can diverge freely — Display's `print`
# HTML-escapes, Show's `render` prints raw. No shared body, no
# ambiguity.
#
# Equivalent to lopsided, but symmetric: both methods are owned
# explicitly rather than leaving one slot unfulfilled.

trait Display {
    fun print(self: *Self);
}

trait Show {
    fun render(self: *Self);
}

struct Button {
    label: str,
}

impl Button with Display (print), Show (render) {
    pub fun print(self: *Button) {
        print("<span>");
        print(self.label);
        print("</span>\n");
    }

    pub fun render(self: *Button) {
        print(self.label);
        print("\n");
    }
}

fun main() {
    let btn: Button = Button { label: "ok" };
    let d: Display = btn as Display;
    d.print<Button>();      # HTML-escaped
    let s: Show = btn as Show;
    s.render<Button>();    # raw
}