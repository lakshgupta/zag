# examples/types/enum_backed.zag
#
# End-to-end demonstration of backed enums (docs/manual/13-enums.md
# §"Backed Enums"). Uses the name-first arrow form (`enum Name -> T`);
# the legacy `enum(T) Name` paren form also parses. Covers:
#   - `enum Status -> u8` integer-backed form with explicit `= value`
#   - `enum Level -> str` string-backed form (round-trips via the
#     str→[]const u8 type alias)
#   - `enum Vowel -> char` char-backed form (round-trips via the
#     char→u32 alias)
#   - `enum AutoInfer -> u8` with auto-inferred values (zig picks the
#     next byte when the user omits `= expr`)
#
# Backing-enum semantics: every variant is a value of type T at compile
# time. The tag type is `T` (vs. the bare-enum `u8` byte tag) so
# comparisons like `Status.Ok == 0` are value-equality, not byte-tag
# equality. This is the bridge that turns zag enums into a "category of
# similar values" surface — the docs/13 design rationale.
#
# The name-first arrow shape is parsed end-to-end.

enum Status -> u8 {
    Ok = 0,
    Warn = 1,
    Err = 2,
}

enum Level -> str {
    Low = "low",
    Medium = "medium",
    High = "high",
}

enum Vowel -> char {
    A = 'a',
    E = 'e',
    I = 'i',
    O = 'o',
    U = 'u',
}

enum AutoInfer -> u8 {
    First,
    Second,
    Third,
}

fun main() {
    let s: u8 = Status.Ok;
    print(s);

    let lvl: str = Level.High;
    print(lvl);

    let a: char = Vowel.A;
    print(a);

    let third: u8 = AutoInfer.Third;
    print(third);
}

@[test]
fun test_enum_backed() {
    let s: u8 = Status.Ok;
    assert(s == 0);
    let t: u8 = AutoInfer.First;
    assert(t == 0);
    let lvl: str = Level.High;
    assert(lvl[0] == 'h');
}
