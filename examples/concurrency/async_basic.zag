## Async/await basic example
##
## v1 (synchronous driver): `async fun` returns Future<T>; `await`
## drives the awaited future inline — `after(ms)` busy-waits on
## CLOCK_MONOTONIC inside the call, then completes its future.
##
## Run: zag run async_basic.zag

import std.time.{after}

async fun delayed_greet(name: str) -> str {
    await after(10);
    return "hello, {name}";
}

async fun main() {
    let greeting: str = await delayed_greet("zag");
    print("{greeting}\n");
}
