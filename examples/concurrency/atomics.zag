## Atomic operations via std.concurrent.atomic (docs/22)
##
##   import std.concurrent.atomic
##
## Simple names: load, store, fetch_add, compare_exchange.
## Each maps to one hardware instruction.
##
## Run: zag run atomics.zag

import std.concurrent.atomic

@[test]
fun test_atomic_ops() {
    let ptr: *i32 = new i32(0);
    defer free(ptr);

    store(ptr, 42);
    assert(load(ptr) == 42);

    let old: i32 = fetch_add(ptr, 1);
    assert(old == 42);
    assert(load(ptr) == 43);
}

fun main() {
    let ptr: *i32 = new i32(0);
    defer free(ptr);

    store(ptr, 42);
    let val: i32 = load(ptr);
    print("loaded: {val}\n");

    let old: i32 = fetch_add(ptr, 1);
    print("fetch_add old: {old}, new: {ptr}\n");

    # compare_exchange returns a plain bool — TRUE when the CAS
    # SUCCEEDED (word still held `expected`, now holds the new
    # value), false when another writer intervened. (Zag wraps zig's
    # `?T`-returning @cmpxchgStrong with `== null` so the success
    # flag is nameable — see lib/std/concurrent/atomic.zag.)
    let ok: bool = compare_exchange(ptr, old + 1, 99);
    if (ok) { print("cas succeeded\n"); }
    let after: i32 = load(ptr);
    print("after cas: {after}\n");

    # A CAS with a stale expected value does NOT swap:
    let stale: bool = compare_exchange(ptr, 0, 5);
    if (!stale) { print("stale cas rejected\n"); }
    print("unchanged: {load(ptr)}\n");
}
