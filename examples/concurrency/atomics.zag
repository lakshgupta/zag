## Atomic operations via std.concurrent.atomic (docs/21)
##
##   import std.concurrent.atomic
##
## Simple names: load, store, fetch_add, compare_exchange.
## Each maps to one hardware instruction.
##
## Run: zag run atomics.zag

import std.concurrent.atomic

@[test]
fun test_atomic_ops() {
    let ptr: *i32 = new i32(0);
    defer free(ptr);

    store(ptr, 42);
    assert(load(ptr) == 42);

    let old: i32 = fetch_add(ptr, 1);
    assert(old == 42);
    assert(load(ptr) == 43);
}

fun main() {
    let ptr: *i32 = new i32(0);
    defer free(ptr);

    store(ptr, 42);
    let val: i32 = load(ptr);
    print("loaded: {val}\n");

    let old: i32 = fetch_add(ptr, 1);
    print("fetch_add old: {old}, new: {ptr}\n");

    # @cmpxchgStrong returns ?i32 — null when the CAS SUCCEEDED,
    # Some(old_value) when it failed (zig's optional encodes the
    # failure case). Bind the optional and read the new value via
    # a load (or check `cas == null` for success).
    let cas: ?i32 = compare_exchange(ptr, old + 1, 99);
    if (cas == null) { print("cas succeeded\n"); }
    let after: i32 = load(ptr);
    print("after cas: {after}\n");
}
