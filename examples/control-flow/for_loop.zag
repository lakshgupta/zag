## For loops over ranges and iterables
fun main() {
    ## `for i in 0..10` — half-open range emits zig's `for (0..10) |i|`.
    let sum: i32 = 0;
    for i in 0..5 {
        sum = sum + i;
    }
    print("half-open sum = {sum}\n");

    ## `for i in 0...10` — inclusive range emits `for (0..10 + 1) |i|`,
    ## which iterates 0,1,...,10 (zig's half-open range semantics get
    ## pushed to inclusive via the +1).
    let count: i32 = 0;
    for i in 0...5 {
        count = count + 1;
    }
    print("inclusive count = {count}\n");

    ## `for x in items()` — verbatim iter expression emits `for (items()) |x|`.
    ## Currently the example statically lists items; future: pass slices,
    ## arrays, or iterators once those are parsed.
    let total: i32 = 0;
    for x in 1..4 {
        total = total + x;
    }
    print("mixed total = {total}\n");

    ## `for _ in 0..3` — wildcard pattern emits `for (0..3) |_|`.
    let tick: i32 = 0;
    for _ in 0..3 {
        tick = tick + 1;
    }
    print("iterations = {tick}\n");
}
