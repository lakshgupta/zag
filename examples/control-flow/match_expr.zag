## Match — literal / range / ident / wildcard arms with guards
fun main() {
    let n: i32 = 3;

    ## Literal arms: each value case maps to one branch. Codegen emits
    ## `__m_<N> == <lit>` for the comparison (a temp binds the scrutinee).
    let is_small: []const u8 = match n {
        0 => "zero",
        1 => "one",
        2 => "two",
        _ => "other",
    };
    print("is_small = {is_small}\n");

    ## Range arm: `start..end` (half-open) emits `__m_0 >= start and __m_0 < end`.
    ## `start...end` (inclusive) emits `..start and __m_0 <= end`.
    let bucket: []const u8 = match n {
        0..10 => "low",
        10..100 => "mid",
        _ => "high",
    };
    print("bucket = {bucket}\n");

    ## Ident arm: the binding name is referenced inside the arm body. Codegen
    ## emits `const x = __m_<N>;` before the body so the expression can use it.
    let doubled: i32 = match n {
        x => x * 2,
        _ => 0,
    };
    print("doubled = {doubled}\n");

    ## Wildcard arm (last) — terminal fallback. The scrutinee temp
    ## `__m_<N>` is referenced in the non-wildcard arm's condition
    ## (`__m_<N> == 3`) so zig 0.16 doesn't flag it as unused. Tested
    ## here — the codegen `cd: match-stmt identifies ident arm emits
    ## const binding` covers the IDENT-pattern arm shape; this
    ## example uses literal-pattern non-wildcard to exercise the same
    ## scrutinee-references bound.
    let safe: i32 = match n {
        3 => 99,
        _ => 0,
    };
    print("safe = {safe}\n");
}
