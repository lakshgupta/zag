## Generic functions with turbofish call sites (docs/manual/16-generics.md §1, §3, §4).
##
## Surfaces exercised end-to-end:
##   - §1 Basic generic fun with turbofish: `identity<T>(x) -> T` + `identity<i32>(42)`
##   - §1 Generic fun with two type params: `pair<T, U>(a, b) -> str`
##   - §3 Trait-bounded generic fun: `max<T: Ordered>(a, b) -> T` + `max<i32>(3, 5)`
##     Codegen emits `if (!@hasDecl(T, "compare")) @compileError(...)` at body entry.
##   - §4 Const generic param: `fill<T, const N: usize>(val: T) -> [N]T` + `fill<i32, 4>(0)`
##
## Generic STRUCTS (§2) + impl<T> blocks landed in the std.collections
## batch (docs/17 §"Generic Types" + lib/std/collections.zag) — see
## examples/stdlib/collections.zag. Const-block initializers (§5, §6)
## remain deferred.

# §1: single-type-param generic. Codegen emits
#     `pub fn identity(comptime T: type, x: T) T { return x; }`.
#     Turbofish call sites `identity<i32>(42)` rewrite to
#     `identity(i32, 42)` in zig — T is a comptime type arg.
fun identity<T>(x: T) -> T {
    return x;
}

# §3: trait-bounded generic. The `Ordered` bound lands as
#     `if (!@hasDecl(T, "compare")) @compileError("type T must implement Ordered ...")`
#     at body entry. Built-in zig primitive types (`i32`, `f64`, etc.) all
#     naturally expose a `compare` method so the bound passes without
#     user work; user-defined types must add an impl-block with a `compare`
#     method to satisfy it.
fun max<T: Ordered>(a: T, b: T) -> T {
    if a > b {
        return a;
    }
    return b;
}

# §4: const-generic + type-param. Zig emits
#     `pub fn fill(comptime T: type, comptime N: usize, val: T) [N]T { ... }`.
#     The `[N]T` return type is the user's compile-time-array-size trick:
#     the comptime N lets zig know the output array length at compile time.
fun fill<T, const N: usize>(val: T) -> [N]T {
    # Body uses canonical `[N]T` array-fill shape now that the
    # `[<ident>]T` parse-time bracket-capture hole in
    # `collectCastType` is closed (Phase 3 followup). The `[<int_lit>]T`
    # shape had always round-tripped, but the `[<ident>]T` case
    # (needed for `comptime N`-shaped array annotations) was the
    # missing piece. Annotation on `var out` is intentionally
    # omitted so the binding type is inferred from the
    # `[N]T { val ... }` array-literal RHS (the array literal goes
    # through `parseArrayLit`, not `collectCastType`, and accepts
    # bracket-ident sizes natively).
    var out = [N]T { val ... };
    return out;
}

# §1: two-type-param generic. Turbofish `pair<i32, str>(7, "zag")` rewrites
#     to `pair(i32, str, 7, "zag")` at the call-site.
fun pair<T, U>(a: T, b: U) -> str {
    return "ok";
}

fun main() {
    # §1 single-type-param round-trip. Pre-bind string-y inputs to avoid
    # template-literal nested quotes inside the print expression.
    let s: str = "hello";
    let int_val: i32 = 42;
    print("identity<i32>(42) = {identity<i32>(int_val)}\n");
    print("identity<str>(s) = {identity<str>(s)}\n");

    # §3 trait-bounded round-trip.
    print("max<i32>(3, 5) = {max<i32>(3, 5)}\n");
    print("max<f64>(1.5, 2.5) = {max<f64>(1.5, 2.5)}\n");

    # §4 const-generic round-trip. The bracket-ident parse hole
    # in `collectCastType` is now closed, so `fill`'s `[N]T`
    # return-type annotation round-trips cleanly. The returned
    # value type-infers to `[4]i32` from the func signature,
    # which makes `let zeros: [4]i32` syntactically valid (the
    # `[4]i32` annotation ALSO round-trips through the new
    # bracket-size carve-out).
    let zeros: [4]i32 = fill<i32, 4>(0);
    print("fill<i32, 4>(0) = {zeros}\n");

    # §1 two-type-param round-trip. Pre-bind to keep the turbofish call-site
    # cleanly separated from the print expression.
    let pair_label: str = pair<i32, str>(7, "zag");
    print("pair<i32, str>(7, zag) = {pair_label}\n");
}

@[test]
fun test_generic_identity() {
    let val: i32 = identity<i32>(42);
    assert(val == 42);
    let s: str = identity<str>("hello");
    assert(s == "hello");
}

@[test]
fun test_generic_max() {
    let a: i32 = max<i32>(3, 5);
    assert(a == 5);
    let b: f64 = max<f64>(1.5, 2.5);
    assert(b == 2.5);
}

@[test]
fun test_generic_fill() {
    let zeros: [4]i32 = fill<i32, 4>(0);
    assert(zeros[0] == 0);
    assert(zeros[3] == 0);
}

@[test]
fun test_generic_pair() {
    let label: str = pair<i32, str>(7, "zag");
    assert(label == "ok");
}
