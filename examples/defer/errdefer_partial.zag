## errdefer — cleanup only on error paths (docs/20 §"errdefer")
##
## `errdefer` runs only when the scope exits via error
## propagation (? or return Err). It does NOT run on the
## success path. The standard pattern for partial init.
##
## Run: zag run errdefer_partial.zag

fun divide(a: i32, b: i32) -> Result<i32, str> {
    if b == 0 {
        return Err("division by zero");
    }
    return Ok(a / b);
}

fun partial_init(a: i32, b: i32) -> Result<i32, str> {
    let p: *i32 = new i32(a);
    errdefer free(p);                  # only runs if ? propagates

    let result: i32 = divide(p, b)?;   # ? may trigger errdefer
    free(p);                           # success path — manual free
    return Ok(result);
}

fun main() {
    match partial_init(10, 2) {
        Ok(v) => print("ok: {v}\n"),
        Err(e) => print("error: {e}\n"),
    }
    match partial_init(10, 0) {
        Ok(v) => print("ok: {v}\n"),
        Err(e) => print("error: {e}\n"),
    }
}

@[test]
fun test_errdefer_partial_success() {
    match partial_init(10, 2) {
        Ok(v) => assert(v == 5),
        Err(e) => assert(true),
    }
}

@[test]
fun test_errdefer_partial_error() {
    match partial_init(10, 0) {
        Ok(v) => assert(true),
        Err(e) => assert(e == "division by zero"),
    }
}
