## Minimal zag project — two files, one command (docs/34)
##
## The smallest possible zag project: zag.toml + src/main.zag.
## Run from the project root:
##   zag run        → compile + execute
##   zag build      → compile only
##   zag generate   → emit zig to build/gen/
##   zag test       → run @[test] functions
##
## This example is the on-disk fixture matching the docs/34
## "Quick Start" section.

fun add(a: i32, b: i32) -> i32 {
    return a + b;
}

fun main() {
    print("hello from zag project\n");
    print("add(2, 3) = {add(2, 3)}\n");
}

@[test]
fun test_add() {
    assert(add(2, 3) == 5);
    assert(add(-1, 1) == 0);
}
