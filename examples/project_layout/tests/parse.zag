## tests/parse.zag — cfgtool test suite (docs/34 §8).
##
## Location implies membership: every `fun test_*` below is a test
## case with NO @[test] annotation (see Parser.test_file in
## src/parser/core.zig). Plain helpers and `main` stay ordinary
## functions. `import lib.{...}` resolves the sibling src module:
## codegen emits `@import("lib")` and the generated build.zig
## registers every src module under its dotted name for both the
## exe root and each test root.
##
## Run from the project root: `zag test`.
## (`examples/run_all.sh` skips tests/ directories — suites only
## run through `zag test`, never `zag run <file>`.)

import lib.{lib_marker}

fun main() {
    print("cfgtool tests — run `zag test` from the project root\n");
}

fun test_lib_marker() {
    assert(lib_marker() == 7);
}

fun test_lib_marker_positive() {
    assert(lib_marker() > 0);
}
