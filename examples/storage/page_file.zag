## Storage: a page-oriented block store — the layer an index/B-tree
## would sit on.
##
##   import std.fs.{File, PAGE_SIZE}
##   import std.io.{ByteWriter, ByteReader}
##
## The append-only log (see append_only.zag) can only scan. A query
## engine needs random access, and random access means fixed-size
## pages: the file is an array of 4096-byte blocks, each addressed by
## an integer block id, so "row 5000" is an arithmetic expression
## rather than a scan.
##
## What this proves about the primitive set:
##   1. std.fs.File.write_block / read_block — read and write one
##      whole page at an integer block id (pread/pwrite under the
##      hood: no seek, no shared file position).
##   2. std.io.ByteWriter / ByteReader — a page is just a byte
##      buffer; the same cursor code that framed the log records
##      frames the slot directory inside a page.
##   3. Slots inside a page: [count:u32][offset:u32][len:u32] × N in
##      a directory grown from the page end downwards, payloads
##      upwards — the classic page layout, built from put_u32_le.
##   4. std.hash.crc32 per page — a torn or bit-rotted page is
##      detected on read instead of being parsed into garbage.
##   5. std.fs.File.size / truncate / sync / block_count — file
##      extent management and the durability barrier.
##
## Every fallible File method returns Result(_, Error) and the caller
## spells the failure policy at the call site with postfix `!`
## (`f.sync()!`), `?`, `catch`, or `match` (docs/manual/19). The old
## `*_or_panic` twins are gone; `File.open(path, mode)` is the single
## constructor (docs/manual/30).
##
## Run: zag run page_file.zag

import std.fs.{File, FileMode, PAGE_SIZE}
import std.io.{ByteWriter, ByteReader}
import std.bytes.{eq as bytes_eq, get_u32_le as read_u32_at}
import std.hash.{crc32}

## Page layout (all little-endian):
##   [0..4)                slot count
##   [4..4+8*N)            directory: (offset:u32, len:u32) × N
##   ...                   free space
##   [..PAGE-4)            payloads, allocated DOWNWARD from the end
##   [PAGE-4..PAGE)        crc32 of bytes [0..PAGE-4)
## The directory grows up from the header and the payloads grow down
## from the checksum, so one `used` boundary is all that has to be
## tracked — the classic split page layout.
const DIR_BASE: usize = 4;
const SLOT_SIZE: usize = 8;
const CRC_SIZE: usize = 4;
const DATA_END: usize = PAGE_SIZE - CRC_SIZE;

fun slot_dir_len(count: u32) -> usize {
    return DIR_BASE + (count as usize) * SLOT_SIZE;
}

## Append `payload` into `page`, returning the new slot count (or
## 0xFFFFFFFF when it doesn't fit — the caller then allocates the
## next page, exactly as a real store would).
fun page_add(page: []u8, payload: []const u8) -> u32 {
    if (page.len != PAGE_SIZE) { __zag_panic("page_add: not a page"); }
    var r: ByteReader = ByteReader.fixed(page[0..]);
    let count: u32 = r.read_u32();
    let dir_end: usize = slot_dir_len(count);

    # Payload region grows DOWN from DATA_END; the directory grows UP
    # from DIR_BASE. The lowest payload offset in use is the current
    # boundary between them.
    var top: usize = DATA_END;
    var i: usize = 0;
    while (i < count as usize) {
        r.seek(DIR_BASE + i * SLOT_SIZE);
        let off: u32 = r.read_u32();
        if ((off as usize) < top) { top = off as usize; }
        i = i + 1;
    }
    if (dir_end + SLOT_SIZE + payload.len > top) { return 0xFFFFFFFF; }

    let offset: usize = top - payload.len;
    var w: ByteWriter = ByteWriter.fixed(page[0..]);
    w.seek(offset);
    w.write_all(payload);

    # Narrowing casts go through locals: the `as` lowering only emits
    # the truncating form for an ident with a tracked type (a direct
    # `.len` member expression emits a plain @as, which zig rejects
    # for 64 -> 32).
    let off_words: usize = offset;
    let len_words: usize = payload.len;
    w.seek(dir_end);
    w.write_u32(off_words as u32);
    w.write_u32(len_words as u32);
    w.seek(0);
    w.write_u32(count + 1);
    page_seal(page);
    return count + 1;
}

## Read slot `idx` out of `page` into `out`; returns the length.
fun page_get(page: []const u8, idx: u32, out: []u8) -> usize {
    var r: ByteReader = ByteReader.fixed(page[0..]);
    let count: u32 = r.read_u32();
    if (idx >= count) { return 0; }
    r.seek(DIR_BASE + (idx as usize) * SLOT_SIZE);
    let off: u32 = r.read_u32();
    let len: u32 = r.read_u32();
    var i: usize = 0;
    while (i < len as usize) {
        out[i] = page[off as usize + i];
        i = i + 1;
    }
    return len as usize;
}

## Stamp the trailing crc32 over everything before it.
fun page_seal(page: []u8) {
    let sum: u32 = crc32(page[0..DATA_END]);
    var w: ByteWriter = ByteWriter.fixed(page[0..]);
    w.seek(DATA_END);
    w.write_u32(sum);
}

## Verify a page: false means the page is torn/corrupt and must not
## be parsed.
fun page_verify(page: []const u8) -> bool {
    let stored: u32 = read_u32_at(page, DATA_END);
    let sum: u32 = crc32(page[0..DATA_END]);
    return stored == sum;
}

fun main() {
    let path: str = "/tmp/zag_page_file.pages";
    var f: File = File.open(path, FileMode.Create)!;

    ## Pre-extend to 2 pages: a real store grows the file in extents
    ## rather than one write at a time.
    f.truncate(PAGE_SIZE * 2)!;
    print("pre-extended to {f.size()!} bytes ({f.block_count()!} pages)\n");

    ## Build page 0 in memory, then write it as one block.
    var page: [PAGE_SIZE]u8 = undefined;
    var i: usize = 0;
    while (i < PAGE_SIZE) { page[i] = 0; i = i + 1; }

    var count: u32 = 0;
    count = page_add(page[0..], "alpha");
    count = page_add(page[0..], "beta");
    count = page_add(page[0..], "gamma");
    assert(count == 3);
    f.write_block(0, page[0..])!;
    f.sync()!;

    ## Read page 0 back by block id and verify + decode it.
    var back: [PAGE_SIZE]u8 = undefined;
    let ok: bool = f.read_block(0, back[0..])!;
    assert(ok);
    assert(page_verify(back[0..]));

    var val: [256]u8 = undefined;
    let n0: usize = page_get(back[0..], 0, val[0..]);
    assert(bytes_eq(val[0..n0], "alpha"));
    print("page 0: {count} slots, slot0={val[0..n0]}, crc ok\n");
    let n2: usize = page_get(back[0..], 2, val[0..]);
    assert(bytes_eq(val[0..n2], "gamma"));
    print("page 0: slot2={val[0..n2]}\n");

    ## A corrupt page is DETECTED, not parsed: flip a payload byte.
    back[64] = back[64] ^ 0xFF;
    assert(!page_verify(back[0..]));
    print("corruption detected: crc mismatch after flipping one byte\n");

    ## Fill page 1 until it reports "doesn't fit", then confirm the
    ## store would roll over to a new page.
    var page1: [PAGE_SIZE]u8 = undefined;
    i = 0;
    while (i < PAGE_SIZE) { page1[i] = 0; i = i + 1; }
    var row: [64]u8 = undefined;
    i = 0;
    while (i < 64) { row[i] = 'x'; i = i + 1; }
    var added: u32 = 0;
    var full: bool = false;
    i = 0;
    while (i < 100) {
        let c: u32 = page_add(page1[0..], row[0..64]);
        if (c == 0xFFFFFFFF) { full = true; break; }
        added = c;
        i = i + 1;
    }
    assert(full);
    f.write_block(1, page1[0..])!;
    f.sync()!;
    print("page 1: held {added} x 64B rows before it filled (rolled over)\n");

    f.close()!;

    ## Reopen read-only: pages are still there (durability check).
    var g: File = File.open(path, FileMode.Read)!;
    assert(g.block_count()! == 2);
    var again: [PAGE_SIZE]u8 = undefined;
    assert(g.read_block(0, again[0..])!);
    assert(page_verify(again[0..]));
    let n1: usize = page_get(again[0..], 1, val[0..]);
    assert(bytes_eq(val[0..n1], "beta"));
    print("reopened: {g.block_count()!} pages, slot1={val[0..n1]}\n");
    g.close()!;
}

@[test]
fun test_page_add_get_roundtrip() {
    var page: [PAGE_SIZE]u8 = undefined;
    var i: usize = 0;
    while (i < PAGE_SIZE) { page[i] = 0; i = i + 1; }

    let c: u32 = page_add(page[0..], "hello");
    assert(c == 1);
    var out: [64]u8 = undefined;
    let n: usize = page_get(page[0..], 0, out[0..]);
    assert(n == 5);
    assert(bytes_eq(out[0..n], "hello"));
    assert(page_verify(page[0..]));
}

@[test]
fun test_block_write_read_file() {
    var f: File = File.open("/tmp/zag_page_test.pages", FileMode.Create)!;
    f.truncate(PAGE_SIZE)!;
    var page: [PAGE_SIZE]u8 = undefined;
    var i: usize = 0;
    while (i < PAGE_SIZE) { page[i] = 0; i = i + 1; }
    _ = page_add(page[0..], "block");
    f.write_block(3, page[0..])!;

    var back: [PAGE_SIZE]u8 = undefined;
    assert(f.read_block(3, back[0..])!);
    assert(page_verify(back[0..]));
    var out: [64]u8 = undefined;
    let n: usize = page_get(back[0..], 0, out[0..]);
    assert(bytes_eq(out[0..n], "block"));
    # Reading a block past EOF reports absent rather than garbage.
    assert(!f.read_block(9, back[0..])!);
    f.close()!;
}
