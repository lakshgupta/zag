## Structs with methods and operator overloading
##
## Run: zag run vec3.zag

import std.math

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

impl Vec3 {
    pub fun new(x: f64, y: f64, z: f64) -> Vec3 {
        return Vec3 { x: x, y: y, z: z };
    }

    pub fun length(self: *const Vec3) -> f64 {
        return math.sqrt(self.x * self.x + self.y * self.y + self.z * self.z);
    }

    pub fun __add__(a: Vec3, b: Vec3) -> Vec3 {
        return Vec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z };
    }
}

fun main() {
    let v = Vec3.new(1.0, 2.0, 3.0);
    print("length = {v.length()}\n");

    let w = v + Vec3.new(4.0, 5.0, 6.0);
    print("sum = ({w.x}, {w.y}, {w.z})\n");
}
