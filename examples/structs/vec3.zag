## Structs with methods, struct-literal construction, and field access.
## Run: zag run examples/structs/vec3.zag

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

impl Vec3 {
    pub fun new(x: f64, y: f64, z: f64) -> Vec3 {
        return Vec3 { x: x, y: y, z: z };
    }

    pub fun sumsq(self: *const Vec3) -> f64 {
        return self.x * self.x + self.y * self.y + self.z * self.z;
    }
}

fun main() {
    let v: Vec3 = Vec3.new(1.0, 2.0, 3.0);
    let v2: Vec3 = Vec3 { x: 4.0, y: 5.0, z: 6.0 };

    print("v = ({v.x}, {v.y}, {v.z})\n");
    print("v2 = ({v2.x}, {v2.y}, {v2.z})\n");
    print("v.sumsq = {v.sumsq()}\n");
}
