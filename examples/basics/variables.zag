## Variables, constants, and primitive types
##
## Run: zag run variables.zag

fun main() {
    # Immutable binding
    let x: i32 = 42;
    print("x = {x}\n");

    # Mutable variable
    var y: f64 = 3.14;
    y = y * 2.0;
    print("y = {y}\n");

    # Compile-time constant
    const PI: f64 = 3.141592653589793;
    print("pi = {PI:.5}\n");

    # Type inference
    let z: i32 = 100;
    let flag: bool = true;
    let ch: u8 = 'Z';

    print("z = {z}, flag = {flag}, ch = {ch}\n");
}

@[test]
fun test_variable_mutation() {
    var a: i32 = 10;
    a = a + 5;
    assert(a == 15);
    var b: f64 = 2.5;
    b = b * 4.0;
    assert(b == 10.0);
}
