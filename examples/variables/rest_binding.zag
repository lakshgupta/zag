## Variables — rest bindings (`...name`)
##
## Per docs/04 §"Destructuring", the rest-binding form `...name`
## captures leftover elements after a fixed-position prefix. The source
## may be a literal (codegen emits the positional sub-tuple form) or a
## runtime slice expression (codegen emits the open-ended `__destruct_0[N..]`
## slicing form). This example exercises all four published forms so
## regressions are caught by `examples/run_all.sh`.
##
## Run: zag run rest_binding.zag

fun main() {
    # Tuple rest: literal source (4 elements; first 1 fixed, rest
    # captures positions 1..3 via positional sub-tuple materialization).
    let (first, ...rest) = (10, 20, 30, 40);
    let rest_sum: i32 = rest[0] + rest[1] + rest[2];
    print("tuple rest: first={first} sum_rest={rest_sum}\n");

    # Array rest from an explicit-list literal (positions 1..3 stay
    # as positional sub-tuple because the literal is known at compile
    # time).
    let [head, ...tail] = [4]i32 { 100, 200, 300, 400 };
    let tail_sum: i32 = tail[0] + tail[1] + tail[2];
    print("array rest: head={head} sum_tail={tail_sum}\n");

    # Nested rest: outer pair + inner pair + rest binding. The outer
    # temp carries the WHOLE source; the inner rest re-enters through
    # __destruct_0[1][N..] (chunked path).
    let (a, (b, ...ir)) = (1, (2, 3, 4));
    let ir_sum: i32 = ir[0] + ir[1];
    print("nested rest: a={a} b={b} sum_ir={ir_sum}\n");

    # Runtime-RHS rest: source is itself a slice expression on a bound
    # array (NOT a tuple_lit). The codegen walker detects `getTopElements`
    # returning empty for `.ident` and routes to the open-ended
    # `__destruct_0[N..]` slicing form. Note: we bridge via a let-binding
    # before slicing rather than slicing an array literal directly,
    # because the current codegen emits `[N]T{...}` without a trailing
    # space and zig's parser can't disambiguate the slice bracket from
    # the array-literal tail. The runtime-vs-literal split still fires
    # because the destructuring target (`source`) is an `.ident`, not
    # a `.tuple_lit`.
    var src_arr: [3]i32 = { 7, 8, 9 };
    let source: []i32 = src_arr[0..];
    let [s_first, ...s_rest] = source;
    let s_rest_sum: i32 = s_rest[0] + s_rest[1];
    print("runtime rest: s_first={s_first} sum_s_rest={s_rest_sum}\n");
}

@[test]
fun test_rest_binding() {
    let (head, ...tail) = (1, 2, 3);
    assert(head == 1);
    assert(tail[0] == 2);
    assert(tail[1] == 3);

    let [a, ...rest] = [3]i32 { 7, 8, 9 };
    assert(a == 7);
    assert(rest[0] == 8);
    assert(rest[1] == 9);
}
