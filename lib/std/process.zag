## std.process — process spawn / exit primitives.
##
## v0.1 Tier-1 migration: `exit` is now a real zag impl backed by the
## always-emitted `__zag_exit` preamble helper (src/codegen/core.zig,
## a forwarder onto `std.os.linux.exit`). The pre-migration
## `process_exit` router row emitted
## `(std.os.linux.exit(@as(u8, @intCast(code))))` inline; the
## preamble helper takes `i32` directly so the .zag body is the
## 1-line canonical form. Router row retired in the Tier-1 migration.
##
## `exec` — REAL impl (same migration): backed by the always-emitted
## `__zag_process_spawn` preamble helper — zig 0.16's
## std.process.spawn(io, .{ .argv = ... }) + kill + wait, with the
## .exited term mapped to the child's exit code and any other term
## (signal/stop/abort) or spawn/wait failure mapped to 255. The
## anonymous-struct options literal and the term-union switch live in
## the zig helper because zag source cannot express those shapes; the
## pre-migration `process_exec` router row emitted the same block
## inline and is retired. Call sites resolve through the @import +
## per-selector alias (`const exec = __zag_imported_<i>.exec;`).

pub fun exit(code: i32) {
    __zag_exit(code);
}

pub fun exec(argv: []const []const u8) -> i32 {
    return __zag_process_spawn(argv);
}
