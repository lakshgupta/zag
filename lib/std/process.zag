## std.process — process spawn / exit primitives.
##
## v0.3 syscall-FFI migration: `exit` is a real zag impl backed by
## lib/std/posix.zag's posix.exit (`std.os.linux.exit` direct; the
## `__zag_exit` preamble helper retired into .zag). The import binds
## the facade entry as `sys_exit` so this module's own `pub fun exit`
## keeps its public name without a module-level clash. The
## pre-migration `process_exit` router row emitted
## `(std.os.linux.exit(@as(u8, @intCast(code))))` inline; retired in
## the Tier-1 migration.
##
## `exec` — REAL impl (v0.4): the LAST __zag_posix-family preamble
## resident, `__zag_process_spawn` (the std.process.spawn(+SpawnOptions
## literal)+kill+wait wrapper zig had to host because .zag can't spell
## anonymous struct literals), retired into lib/std/posix.zag's
## spawn — a raw fork/execve/waitpid path. exec is now a pure .zag
## delegation; the posix family is completely out of the preamble.

pub import std.posix.{exit as sys_exit, spawn as sys_spawn}
import std.errno.{Errno}

pub fun exit(code: i32) {
    sys_exit(code);
}

## exec — run `argv` to completion and return the child's exit code.
## Under the P1 posix tier split this is a `Result`, which removes the
## old 255 ambiguity: 255 used to mean EITHER "spawn setup failed"
## (empty argv, arena overflow, fork/waitpid errno) OR "the child
## exited with 255", and no caller could tell which. Now a setup
## failure is `Err(errno)` and `Ok(255)` is unambiguously a child code.
## Two shell conventions survive inside `spawn` and are documented
## there: a failed execve in the child exits 127, and a child killed by
## a signal reports 255.
pub fun exec(argv: []const []const u8) -> Result(i32, Errno) {
    return sys_spawn(argv);
}
