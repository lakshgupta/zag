## std.process — process spawn / exit primitives.
##
## Phase 3 surface for the cli.zag dispatcher. The two functions
## below let cli.zag fork+execve child processes (to recursively
## invoke zag in --leaf-process mode) and forward exit codes
## from cli_main back to the parent shell. As with the rest of
## std/* (argv/env/fs), the bodies here are throwaway; the
## codegen router in src/codegen/builtins.zig REWRITES the call
## site at compile time before any zag reader sees the verbatim
## form.
##
## exec emits a per-call (blk: { ... }) wrapper containing:
##   - per-arg [:0]u8 allocations via page_allocator
##   - /proc/self/environ read into envp_z
##   - fork+execve+waitpid with the caller's argv
## It returns the child's i32 exit code (or 255 on parent
## fork failure / 127 on child exec failure).
##
## exit emits (std.os.linux.exit(@as(u8, @intCast(arg)))) as a
## statement-shaped value — it works in both statement position
## (`exit(rc);`) and expression position (`let _ = exit(rc);`).
## std.os.linux.exit takes u8 only (POSIX exit-code convention);
## the @as(u8, @intCast(...)) clamps wider i32 to one byte.

pub fun exec(argv: []const []const u8) -> i32 {
    return 255;
}

pub fun exit(code: i32) {
    return;
}
