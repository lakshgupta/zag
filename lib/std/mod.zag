## Top-level re-export barrel — `import std` brings the whole surface in.
##
## Selective imports are the canonical form (docs/manual/22-modules.md
## §Imports). `pub use <path> as <name>` module re-exports
## (docs/manual/22 §Re-exports) are ALSO implemented (emitted as
## `pub const <name> = @import(...)`), so this file could collapse to
## `pub use std.types as types`-style surface — the selective-import
## list stays because it pulls the exact names users expect without
## namespace indirection.

pub import std.error.{Error, Context, ErrorExt}
pub import std.types.{String}
pub import std.fmt.{Display as StringDisplay}
pub import std.fmt.{Display, Writer, FmtError}
pub import std.time.{Duration, Timer}
pub import std.time.{now}
pub import std.atomic.{AtomicI32, AtomicI64, AtomicUsize, AtomicBool, Ordering}
pub import std.bench.{Counters}
# Phase 1: codegen-router-wired entries. Each selective import here
# installs one row in src/codegen/builtins.zig's `builtin_table` so the
# matching bare-name call site (`get()`, `getEnv(...)`, `read_file(...)`)
# fires the corresponding genBuiltinCall arm. argv/env/fs are split into
# separate modules so the codegen-router path can be selectively widened
# without dragging unrelated surface into the gzip-installed executable.
#
# Phase 0 entry (fully migrated): `pub import std.argv.{get}` → REAL
# pure-zag impl chain — lib/std/argv.zag delegates to std.posix.argv,
# which reads /proc/self/cmdline directly (v0.5 self-hosting migration;
# the interim __zag_argv main-entry capture and its stdlibPreambleName
# fast path are retired). The argv_get router row was RETIRED in the
# v0.1 Tier-1 migration; the call site resolves via the @import+alias
# fallthrough.
# Phase 1 entries:
#   SUPERSEDED (the `!` collapse): every `std.fs.{read_file}`/
#   `{write_file}` reference below describes the pre-P2 surface. The
#   barrel now publishes `read_file` / `write_file` / `try_read` /
#   `mkdir` (one Result-returning spelling per operation, named for the
#   OPERATION rather than the failure policy — `!` at the call site
#   spells the fail-fast form) and the `File` surface
#   (`File`, `FileMode`, `PAGE_SIZE`); the panicking `read_file` /
#   `write_file` pair and the `*_or_panic` twins are GONE.
#   `pub import std.env.{get_env}`     → REAL impl in lib/std/env.zag backed by
#                                         __zag_getenv (Tier-1 migration;
#                                         renamed from `getEnv`).
#   `pub import std.fs.{read_file}`    → REAL impl in lib/std/fs.zag backed by
#                                         the __zag_posix preamble family
#                                         (__zag_openat / __zag_read /
#                                         __zag_close) — itself fully retired
#                                         into lib/std/posix.zag by the v0.3/v0.4
#                                         passes; byte copies go through
#                                         std.mem.memcpy.
#                                         The codegen-router entry fs_read_file was
#                                         RETIRED in favour of the @import+alias
#                                         fallthrough in src/codegen/core.zig's imports
#                                         loop (Option A pass-through).
# v0.1 Tier-1 migration notes:
#   `pub import std.time.{now}`        → REAL impl in lib/std/time.zag (__zag_clock_gettime).
#   `pub import std.fs.{write_file}`   → REAL impl in lib/std/fs.zag (__zag_openat/write/close);
#                                         fs_write_file router row retired.
#   `pub import std.process.{exit}`    → REAL impl in lib/std/process.zag (__zag_exit);
#                                         process_exit router row retired.
#   `pub import std.mem.{alloc}`       → REAL impl in lib/std/mem.zag (pure-zag mmap allocator);
#                                         builtin_alloc router row retired.
#   `pub import std.debug.{panic}`     → REAL impl in lib/std/debug.zag (__zag_panic);
#                                         builtin_panic router row retired.
#   `pub import std.fs.{mkdir}`        → REAL impl in lib/std/fs.zag (__zag_mkdirat,
#                                         EEXIST coalesced to 0 for mkdir -p semantics);
#                                         fs_mkdir router row retired.
#   `pub import std.process.{exec}`   → REAL impl in lib/std/process.zag
#                                         (__zag_process_spawn: std.process.spawn+
#                                         wait, .exited→exit code). Under the P1
#                                         posix tier split this returns
#                                         Result(i32, Errno) — a spawn SETUP
#                                         failure is an Err, so 255 no longer
#                                         means two different things;
#                                         process_exec router row retired.
pub import std.argv.{get}
pub import std.env.{get_env}
# IO is Result-shaped throughout (P2 + the `!` collapse): every fallible
# entry point returns Result(_, Error) and there is exactly one spelling
# of each operation. The failure policy lives at the CALL SITE —
# `read_file("x")!` panics, `?` propagates, `catch` falls back, and
# `match` branches. mkdir keeps `mkdir -p` semantics with EEXIST as Ok.
# The four fs constructor names collapsed into `File.open(path, mode)`
# with a mandatory `FileMode` (cross-module types cannot resolve a
# same-name overload — docs/manual/30).
pub import std.fs.{read_file, write_file, try_read, mkdir}
pub import std.fs.{File, FileMode, PAGE_SIZE}
pub import std.process.{exec}
pub import std.process.{exit}
pub import std.mem.{alloc}
pub import std.collections.{ArrayList, HashMap}
pub import std.async.{EventLoop, sleep, now_ms}
pub import std.strings.{split, join, replace, index_of, contains, starts_with, ends_with, eq, trim, trim_start, trim_end, to_upper, to_lower, repeat}
pub import std.io.{read_line, read_all, write_all}
pub import std.math.{min, max, abs, clamp, is_pow2, next_pow2, gcd}
pub import std.fmt.{format_u64, format_i64, parse_u64, parse_i64}
pub import std.sort.{sort, binary_search}
pub import std.encoding.{base64_encode, base64_decode, hex_encode, hex_decode, utf8_validate}
pub import std.hash.{fnv1a32, fnv1a64, crc32, sha256}
pub import std.random.{XorShift64Star}
pub import std.debug.{panic}
pub import std.json.{Json, JsonPair, parse, stringify}
# The error vocabulary the Result tier speaks — a std.posix caller
# needs the type to name what it is handling.
#
# KNOWN BUG (pre-existing, NOT caused by this line): the whole-module
# barrel form `import std.{X}` does not resolve at all today, for ANY X
# (`import std.{read_file}` fails identically). The barrel's mirror is
# never written — `materializeWalk` deliberately skips `mod.zag` — so
# codegen's `@import("std/mod.zig")` hits FileNotFound. The working
# spelling is the direct module path: `import std.errno.{Errno}`.
# Recorded in docs/architecture.md §Known Coverage Gap.
pub import std.errno.{Errno, ErrnoKind}
