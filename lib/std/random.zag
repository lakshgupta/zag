## std.random — deterministic pseudo-random generation.
##
##   import std.random.{XorShift64Star}
##
##   let rng: XorShift64Star = XorShift64Star.new();
##   let r: u64 = rng.next_u64();
##   let f: f64 = rng.next_f64();
##
## `new()` seeds from /dev/urandom (8 bytes); the seed can be
## overridden with `seed_from(entropy: u64)` for reproducibility.
## Not cryptographically secure — use for tests, shuffles, jitter.

import std.posix.{openat, close, read_full}
import std.errno.{Errno}

pub struct XorShift64Star {
    state: u64,
}

impl XorShift64Star {
    pub fun new() -> XorShift64Star {
        let ent: u64 = urandom_u64();
        return XorShift64Star { state: ent };
    }

    pub fun seed_from(entropy: u64) -> XorShift64Star {
        return XorShift64Star { state: entropy };
    }

    pub fun next_u64(self: *XorShift64Star) -> u64 {
        # xorshift64*: shift-twist-xor in u64, then the final multiply
        # wraps mod 2^64 via `*%` (docs/05 §Wrapping Arithmetic). The
        # shifts discard out-of-range bits by design (zig's `<<`/`>>`
        # do not panic on bit loss), and the u64 `*%` yields exactly
        # the mod-2^64 fold the v0.1 u128 widen-and-modulo form
        # computed — the direct form is value-identical.
        var s: u64 = self.state;
        s = s ^ (s >> 12);
        s = s ^ (s << 25);
        s = s ^ (s >> 27);
        self.state = s;
        return s *% 2685821657736338717;
    }

    pub fun next_u32(self: *XorShift64Star) -> u32 {
        # Low 32 bits of the u64 stream — explicit fold (checked
        # @intCast would panic on values above 2^32).
        let v: u64 = self.next_u64();
        return (v % 4294967296) as u32;
    }

    pub fun next_f64(self: *XorShift64Star) -> f64 {
        let top: u64 = self.next_u64() >> 11;
        return (top as f64) / 9007199254740992.0;
    }
}

fun urandom_u64() -> u64 {
    const FALLBACK: u64 = 0x9E3779B97F4A7C15;
    var buf: [8]u8 = undefined;
    # posix.openat returns Result(i32, Errno): a failed open is an `Err`,
    # not a high-bit-set usize that a `fd as i32` would TRAP on (the old
    # shape aborted the process instead of falling back to the seed).
    let fr: Result(i32, Errno) = openat(std.posix.AT.FDCWD, "/dev/urandom", 0, 0);
    if let Err(_) = fr { return FALLBACK; }
    var fd: i32 = 0;
    if let Ok(v) = fr { fd = v; }
    # read_full retries EINTR and accumulates short reads, so a signal
    # or a partial transfer can no longer masquerade as "not enough
    # bytes". Anything short of a full 8 — a real errno or EOF — falls
    # back to the fixed seed. Close on every path so a failure cannot
    # leak the fd.
    let r: Result(usize, Errno) = read_full(fd, buf[0..]);
    if let Err(_) = r {
        _ = close(fd); # deliberate discard: read-only fd on a failure path; the read errno is the primary failure.
        return FALLBACK;
    }
    var have: usize = 0;
    if let Ok(n) = r { have = n; }
    if (have < 8) {
        _ = close(fd); # deliberate discard: read-only fd; a short /dev/urandom read is not a durability failure.
        return FALLBACK;
    }
    var out: u64 = 0;
    # Build little-endian via a running byte weight: zig 0.16 requires
    # shift amounts to be Log2Int (u6), so `<< (i * 8)` is rejected —
    # multiply-accumulate instead (weights stay < 2^56, no overflow).
    var place: u64 = 1;
    var i: usize = 0;
    while (i < 8) {
        let byte: u64 = buf[i] as u64;
        out = out | (byte * place);
        if (i < 7) { place = place * 256; }
        i = i + 1;
    }
    _ = close(fd); # deliberate discard: /dev/urandom was opened read-only, so there is no write-back to lose.
    return out;
}
