## std.types — core data types shared across the standard library.
##
## Canonical home of the heap-allocated mutable UTF-8 `String` type
## (docs/manual/11-strings.md). `String` moved here from
## `std.string` so the type lives under the "types" namespace:
##
##   import std.types.{String}
##
## `std.string` still re-exports it (`pub import std.types.{String}`)
## so `import std.string.{String}` keeps working for existing
## callers.
##
## Real impl — methods compose against the always-emitted
## `__zag_page_alloc` / `__zag_page_realloc` / `__zag_page_free`
## / `__zag_memcpy` / `__zag_panic` family primitives in the
## generated zig preamble (see src/codegen/core.zig's preamble block).
## After zag's transpile pass, build/gen/std/types.zig is the
## source of truth at runtime — this .zag surface matches its
## emitted zig shape 1:1, with method names in snake_case (the
## codegen router arms in src/codegen/expr.zig emit
## `__zag_String.with_capacity(N)` as the migrated call site, so
## impl-block method names must match).
##
## Layout { ptr: [*]u8, len: usize, cap: usize }. The `*u8` raw
## pointer shape rewrites through zagTypeToZig's `*raw T` rule
## to zig `[*]u8` (many-pointer) — see
## src/codegen/decl.zig::zagTypeToZig's v1.5 raw-pointer block.

pub struct String {
    ptr: *raw u8,
    len: usize,
    cap: usize,
}

impl String {
    pub fun with_capacity(cap: usize) -> String {
        let p: *raw u8 = __zag_page_alloc(cap);
        return String { ptr: p, len: 0, cap: cap };
    }

    pub fun as_str(self: *const String) -> []const u8 {
        return self.ptr[0..self.len];
    }

    pub fun push_str(self: *String, s: []const u8) -> void {
        let needed: usize = self.len + s.len;
        if (needed > self.cap) {
            var new_cap: usize = self.cap;
            if (new_cap == 0) { new_cap = 16; }
            while (new_cap < needed) { new_cap = new_cap * 2; }
            self.ptr = __zag_page_realloc(self.ptr, self.cap, new_cap);
            self.cap = new_cap;
        }
        __zag_memcpy(self.ptr[self.len..self.len + s.len], s, s.len);
        self.len = needed;
    }

    pub fun push_ch(self: *String, ch: u8) -> void {
        let needed: usize = self.len + 1;
        if (needed > self.cap) {
            var new_cap: usize = self.cap;
            if (new_cap == 0) { new_cap = 16; }
            while (new_cap < needed) { new_cap = new_cap * 2; }
            self.ptr = __zag_page_realloc(self.ptr, self.cap, new_cap);
            self.cap = new_cap;
        }
        self.ptr[self.len] = ch;
        self.len = needed;
    }

    pub fun pop_ch(self: *String) -> ?u8 {
        if (self.len == 0) { return null; }
        self.len = self.len - 1;
        return self.ptr[self.len];
    }

    pub fun clear(self: *String) -> void {
        self.len = 0;
    }

    pub fun insert_ch(self: *String, pos: usize, ch: u8) -> void {
        if (pos > self.len) { __zag_panic("String.insert_ch: position out of bounds"); }
        let needed: usize = self.len + 1;
        if (needed > self.cap) {
            var new_cap: usize = self.cap;
            if (new_cap == 0) { new_cap = 16; }
            while (new_cap < needed) { new_cap = new_cap * 2; }
            self.ptr = __zag_page_realloc(self.ptr, self.cap, new_cap);
            self.cap = new_cap;
        }
        var i: usize = self.len;
        while (i > pos) {
            self.ptr[i] = self.ptr[i - 1];
            i = i - 1;
        }
        self.ptr[pos] = ch;
        self.len = needed;
    }
}
