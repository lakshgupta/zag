## std.types.string — String (lives at lib/std/types/string.zag).
##
## std.types is a DIRECTORY module (see lib/std/types/mod.zag): the
## heap-allocated mutable UTF-8 `String` type (docs/manual/11-strings)
## lives in its own file. `String` moved here from `std.string` so
## the type lives under the "types" namespace:
##
##   import std.types.{String}
##
## `std.string` no longer exists — the type is ONLY importable as
## `std.types.{String}` (the legacy `std.string` module was removed
## so a stray `import std.string.{String}` fails resolution instead
## of binding a second path to the same type).
##
## Real impl — methods compose against std.mem's pure-zag allocator
## surface (alloc_raw/realloc_raw over posix.mmap; the
## __zag_page_alloc/__zag_page_realloc preamble helpers retired in
## the v0.5 self-hosting pass) and `__zag_panic` for bounds. The
## byte copies use std.mem's `memcpy` (the `__zag_memcpy` preamble
## helper retired there in the v0.4 pass). After zag's transpile pass,
## build/gen/std/types.zig is the source of truth at runtime — this
## .zag surface matches its emitted zig shape 1:1, with method
## names in snake_case (the codegen router arms in
## src/codegen/expr.zig emit `__zag_String.with_capacity(N)` as the
## migrated call site, so impl-block method names must match).

import std.mem.{memcpy, alloc_raw, realloc_raw, release}
##
## Layout { ptr: [*]u8, len: usize, cap: usize }. The `*u8` raw
## pointer shape rewrites through zagTypeToZig's `*raw T` rule
## to zig `[*]u8` (many-pointer) — see
## src/codegen/decl.zig::zagTypeToZig's v1.5 raw-pointer block.

pub struct String {
    ptr: *raw u8,
    len: usize,
    cap: usize,
}

impl String {
    pub fun with_capacity(cap: usize) -> String {
        let p: *raw u8 = alloc_raw(cap);
        return String { ptr: p, len: 0, cap: cap };
    }

    # Release the backing buffer. `cap` is the exact discharge the ledger
    # charged (`alloc_raw(cap)` / the last `realloc_raw(_, _, cap)`), the
    # same contract ArrayList.deinit follows — so a String released this
    # way returns `Counters.snapshot().bytes_live` to its baseline. The
    # `cap > 0` guard mirrors ArrayList: a zero-cap String's mapping is
    # released by nothing and its charge is zero, so there is no residue.
    #
    # Setting `cap = 0` (never touching `ptr`) mirrors ArrayList: the
    # view is empty, so a second `deinit()` is a no-op rather than an
    # munmap of an already-released range.
    pub fun deinit(self: *String) {
        if (self.cap > 0) {
            release(self.ptr, self.cap);
            self.len = 0;
            self.cap = 0;
        }
    }

    pub fun as_str(self: *const String) -> []const u8 {
        return self.ptr[0..self.len];
    }

    pub fun push_str(self: *String, s: []const u8) -> void {
        let needed: usize = self.len + s.len;
        if (needed > self.cap) {
            var new_cap: usize = self.cap;
            if (new_cap == 0) { new_cap = 16; }
            while (new_cap < needed) { new_cap = new_cap * 2; }
            self.ptr = realloc_raw(self.ptr, self.cap, new_cap);
            self.cap = new_cap;
        }
        memcpy(self.ptr[self.len..self.len + s.len], s, s.len);
        self.len = needed;
    }

    pub fun push_ch(self: *String, ch: u8) -> void {
        let needed: usize = self.len + 1;
        if (needed > self.cap) {
            var new_cap: usize = self.cap;
            if (new_cap == 0) { new_cap = 16; }
            while (new_cap < needed) { new_cap = new_cap * 2; }
            self.ptr = realloc_raw(self.ptr, self.cap, new_cap);
            self.cap = new_cap;
        }
        self.ptr[self.len] = ch;
        self.len = needed;
    }

    pub fun pop_ch(self: *String) -> ?u8 {
        if (self.len == 0) { return null; }
        self.len = self.len - 1;
        return self.ptr[self.len];
    }

    pub fun clear(self: *String) -> void {
        self.len = 0;
    }

    pub fun insert_ch(self: *String, pos: usize, ch: u8) -> void {
        if (pos > self.len) { __zag_panic("String.insert_ch: position out of bounds"); }
        let needed: usize = self.len + 1;
        if (needed > self.cap) {
            var new_cap: usize = self.cap;
            if (new_cap == 0) { new_cap = 16; }
            while (new_cap < needed) { new_cap = new_cap * 2; }
            self.ptr = realloc_raw(self.ptr, self.cap, new_cap);
            self.cap = new_cap;
        }
        var i: usize = self.len;
        while (i > pos) {
            self.ptr[i] = self.ptr[i - 1];
            i = i - 1;
        }
        self.ptr[pos] = ch;
        self.len = needed;
    }

    # Copy constructor — heap-allocates a fresh buffer holding the
    # caller's bytes (independent of the source's lifetime).
    pub fun from_str(s: []const u8) -> String {
        var out: String = String.with_capacity(s.len);
        out.push_str(s);
        return out;
    }

    # Content equality with a borrowed view (`str`). Note: zig's `==`
    # on slices compares the slice DESCRIPTOR (ptr+len), so this is
    # the method to use for value comparison.
    pub fun eq(self: *const String, other: []const u8) -> bool {
        let a: []const u8 = self.as_str();
        if (a.len != other.len) { return false; }
        var i: usize = 0;
        while (i < a.len) {
            if (a[i] != other[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    pub fun contains(self: *const String, needle: []const u8) -> bool {
        let a: []const u8 = self.as_str();
        if (needle.len == 0) { return true; }
        if (needle.len > a.len) { return false; }
        var i: usize = 0;
        while (i + needle.len <= a.len) {
            if (a[i] == needle[0]) {
                var j: usize = 1;
                var matched: bool = true;
                while (j < needle.len) {
                    if (a[i + j] != needle[j]) { matched = false; break; }
                    j = j + 1;
                }
                if (matched) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    pub fun starts_with(self: *const String, prefix: []const u8) -> bool {
        let a: []const u8 = self.as_str();
        if (prefix.len > a.len) { return false; }
        var i: usize = 0;
        while (i < prefix.len) {
            if (a[i] != prefix[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    pub fun ends_with(self: *const String, suffix: []const u8) -> bool {
        let a: []const u8 = self.as_str();
        if (suffix.len > a.len) { return false; }
        var i: usize = 0;
        while (i < suffix.len) {
            if (a[a.len - suffix.len + i] != suffix[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    # First occurrence of `needle` (byte index), or null.
    pub fun find(self: *const String, needle: []const u8) -> ?usize {
        let a: []const u8 = self.as_str();
        if (needle.len == 0) { return 0; }
        if (needle.len > a.len) { return null; }
        var i: usize = 0;
        while (i + needle.len <= a.len) {
            if (a[i] == needle[0]) {
                var j: usize = 1;
                var matched: bool = true;
                while (j < needle.len) {
                    if (a[i + j] != needle[j]) { matched = false; break; }
                    j = j + 1;
                }
                if (matched) { return i; }
            }
            i = i + 1;
        }
        return null;
    }

    # Borrowed view of the [start, end) byte range (bounds-checked).
    pub fun slice(self: *const String, start: usize, end: usize) -> []const u8 {
        if (start > end || end > self.len) {
            __zag_panic("String.slice: index out of bounds");
        }
        let a: []const u8 = self.as_str();
        return a[start..end];
    }

    # Borrowed view with leading/trailing ASCII whitespace removed.
    pub fun trim(self: *const String) -> []const u8 {
        let a: []const u8 = self.as_str();
        var lo: usize = 0;
        var hi: usize = a.len;
        while (lo < hi) {
            let c: u8 = a[lo];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') { lo = lo + 1; } else { break; }
        }
        while (hi > lo) {
            let c: u8 = a[hi - 1];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') { hi = hi - 1; } else { break; }
        }
        return a[lo..hi];
    }

    # In-place ASCII case conversion (non-ASCII bytes untouched).
    pub fun to_upper(self: *String) {
        var i: usize = 0;
        while (i < self.len) {
            let c: u8 = self.ptr[i];
            if (c >= 'a' && c <= 'z') {
                self.ptr[i] = c - ('a' - 'A');
            }
            i = i + 1;
        }
    }

    pub fun to_lower(self: *String) {
        var i: usize = 0;
        while (i < self.len) {
            let c: u8 = self.ptr[i];
            if (c >= 'A' && c <= 'Z') {
                self.ptr[i] = c + ('a' - 'A');
            }
            i = i + 1;
        }
    }
}
