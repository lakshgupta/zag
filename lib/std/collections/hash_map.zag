## std.collections.hash_map — HashMap<K, V>.
##
## Lives at lib/std/collections/hash_map.zag — std.collections is a
## DIRECTORY module (see array_list.zag's docblock).
##
## HashMap<K, V> — open addressing with linear probing, FNV-1a key
## hashing, equality via the preamble `__zag_keys_eq`/`__zag_key_hash`
## helpers. Value keys (i32/u64/...) compare by value; `str` keys
## compare by CONTENT (std.mem.eql + content FNV) — string-keyed maps
## work, including equal strings in different buffers.
##
##   import std.collections.{HashMap}
##
##   var m: HashMap(i32, str) = HashMap(i32, str).new();
##   m.put(1, "one");
##   print("{m.get(1)}\n");
##   m.deinit();
##
## Ownership: the container owns its heap buffers; `deinit` releases
## them.
pub struct HashMap<K, V> {
    keys: [*]K,
    values: [*]V,
    used: [*]bool,
    cap: usize,
    len: usize,
}

impl HashMap<K, V> {
    pub fun new() -> HashMap<K, V> {
        return HashMap<K, V> { keys: undefined, values: undefined, used: undefined, cap: 0, len: 0 };
    }

    pub fun put(self: *HashMap<K, V>, key: K, value: V) {
        if (self.len * 2 >= self.cap) {
            self.grow();
        }
        let idx: usize = self.probe(key);
        # The key is written UNCONDITIONALLY — a fresh slot's keys[]
        # entry is undefined memory, and the probe's equality check
        # reads it; the update-vs-insert distinction lives in the
        # used[] flag alone.
        self.keys[idx] = key;
        self.values[idx] = value;
        self.used[idx] = true;
        self.len = self.len + 1;
    }

    pub fun get(self: *HashMap<K, V>, key: K) -> V {
        let idx: usize = self.probe(key);
        if (!self.used[idx] || !__zag_keys_eq(K, self.keys[idx], key)) {
            __zag_panic("std.collections.HashMap.get: key not found");
        }
        return self.values[idx];
    }

    pub fun contains(self: *HashMap<K, V>, key: K) -> bool {
        let idx: usize = self.probe(key);
        return self.used[idx] && __zag_keys_eq(K, self.keys[idx], key);
    }

    pub fun len(self: *HashMap<K, V>) -> usize {
        return self.len;
    }

    pub fun deinit(self: *HashMap<K, V>) {
        if (self.cap > 0) {
            __zag_page_free(self.keys as [*]u8, self.cap * size_of(K));
            __zag_page_free(self.values as [*]u8, self.cap * size_of(V));
            __zag_page_free(self.used as [*]u8, self.cap);
            self.cap = 0;
            self.len = 0;
        }
    }

    fun probe(self: *HashMap<K, V>, key: K) -> usize {
        let mask: usize = self.cap - 1;
        var idx: usize = hash_key<K>(key) & mask;
        while (self.used[idx] && !__zag_keys_eq(K, self.keys[idx], key)) {
            idx = (idx + 1) & mask;
        }
        return idx;
    }

    fun grow(self: *HashMap<K, V>) {
        let new_cap: usize = if (self.cap == 0) { 8 } else { self.cap * 2 };
        let old_cap: usize = self.cap;
        let old_keys: [*]K = self.keys;
        let old_values: [*]V = self.values;
        let old_used: [*]bool = self.used;
        var nk: [*]K = __zag_page_alloc(new_cap * size_of(K)) as [*]K;
        var nv: [*]V = __zag_page_alloc(new_cap * size_of(V)) as [*]V;
        var nu: [*]bool = __zag_page_alloc(new_cap) as [*]bool;
        if (old_cap > 0) {
            var i: usize = 0;
            while (i < old_cap) {
                if (old_used[i]) {
                    let mask: usize = new_cap - 1;
                    var idx: usize = hash_key<K>(old_keys[i]) & mask;
                    while (nu[idx]) {
                        idx = (idx + 1) & mask;
                    }
                    nk[idx] = old_keys[i];
                    nv[idx] = old_values[i];
                    nu[idx] = true;
                }
                i = i + 1;
            }
            __zag_page_free(old_keys as [*]u8, old_cap * size_of(K));
            __zag_page_free(old_values as [*]u8, old_cap * size_of(V));
            __zag_page_free(old_used as [*]u8, old_cap);
        }
        self.keys = nk;
        self.values = nv;
        self.used = nu;
        self.cap = new_cap;
    }
}

# Generic FREE fn (not a method): the impl-level `comptime V`
# param would be unused here (hash only touches K), and zig
# rejects unused comptime params. Call sites turbofish the K.
fun hash_key<K>(key: K) -> usize {
    # Preamble helper: CONTENT hashing for slice keys (str), byte
    # hashing for value keys — the comptime K branch lives in pure
    # zig where the dead branch is properly discarded.
    return __zag_key_hash(K, key);
}
