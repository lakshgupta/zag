## std.collections.array_list — ArrayList<T>.
##
## Lives at lib/std/collections/array_list.zag — std.collections is a
## DIRECTORY module: each container type has its own file, and
## lib/std/collections/mod.zag re-exports the public surface:
##
##   import std.collections.{ArrayList}      # → array_list.zag
##   import std.collections.{HashMap}        # → hash_map.zag
##
## ArrayList<T> — growable vector over page-allocated storage.
## Generic STRUCTS (docs/17 §2): impl-block methods emit as orphan
## free fns (`ArrayList_T_push(comptime T, self: *ArrayList(T),
## value: T)`), and call sites dispatch through the generic-instance
## rewrite — `list.push(5)` → `ArrayList_T_push(i32, &list, 5)`.
##
##   import std.collections.{ArrayList}
##
##   var list: ArrayList(i32) = ArrayList(i32).new();
##   list.push(10);
##   list.push(20);
##   print("{list.get(1)}\n");         # 20
##   list.deinit();
##
## Ownership: the container owns its heap buffer; `deinit` releases
## it (call it in long-lived programs).
import std.mem.{alloc_raw, release}

pub struct ArrayList<T> {
    # Typed many-pointer field: the thunk body must REFERENCE T
    # somewhere (zig rejects an unused `comptime T: type` thunk
    # param), and the typed pointer removes the cast layer from
    # push/get/grow entirely.
    items: [*]T,
    len: usize,
    cap: usize,
}

impl ArrayList<T> {
    pub fun new() -> ArrayList<T> {
        return ArrayList<T> { items: undefined, len: 0, cap: 0 };
    }

    pub fun push(self: *ArrayList<T>, value: T) {
        if (self.len == self.cap) {
            self.grow();
        }
        self.items[self.len] = value;
        self.len = self.len + 1;
    }

    pub fun get(self: *ArrayList<T>, idx: usize) -> T {
        if (idx >= self.len) {
            __zag_panic("std.collections.ArrayList.get: index out of bounds");
        }
        return self.items[idx];
    }

    pub fun set(self: *ArrayList<T>, idx: usize, value: T) {
        if (idx >= self.len) {
            __zag_panic("std.collections.ArrayList.set: index out of bounds");
        }
        self.items[idx] = value;
    }

    pub fun len(self: *ArrayList<T>) -> usize {
        return self.len;
    }

    pub fun clear(self: *ArrayList<T>) {
        self.len = 0;
    }

    pub fun deinit(self: *ArrayList<T>) {
        if (self.cap > 0) {
            release(self.items as [*]u8, self.cap * size_of(T));
            self.cap = 0;
            self.len = 0;
        }
    }

    fun grow(self: *ArrayList<T>) {
        let new_cap: usize = if (self.cap == 0) { 4 } else { self.cap * 2 };
        let old_len: usize = self.len;
        var p: [*]T = alloc_raw(new_cap * size_of(T)) as [*]T;
        if (self.cap > 0) {
            var i: usize = 0;
            while (i < old_len) {
                p[i] = self.items[i];
                i = i + 1;
            }
            release(self.items as [*]u8, self.cap * size_of(T));
        }
        self.items = p;
        self.cap = new_cap;
    }
}
