## std.fmt — Display trait + Writer sink + formatting helpers.
##
## Writer wraps a file descriptor and provides writeAll/print.
## Display is the canonical formatting trait.
## __zag_format_val converts any value to a stack-allocated string.
##
## Backed by __zag_Writer in the generated zig preamble.

pub trait Display {
    fun write(self: *const Self, writer: *Writer);
}

pub struct Writer {
    fd: i32,
}

impl Writer {
    pub fun std_out() -> Writer {
        return Writer { fd: 1 };
    }
    pub fun std_err() -> Writer {
        return Writer { fd: 2 };
    }
    pub fun write_all(self: *const Writer, bytes: []const u8) -> void {
        _ = bytes;
    }
    pub fun print(self: *const Writer, fmt: str) -> void {
        _ = fmt;
    }
}

pub enum FmtError {
    Overflow,
    Invalid,
}
