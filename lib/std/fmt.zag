## std.fmt — Display trait + Writer sink + formatting helpers.
##
## Writer wraps a file descriptor and provides write_all/print.
## Display is the canonical formatting trait.
## __zag_format_val converts any value to a stack-allocated string.
##
## Backed by __zag_Writer in the generated zig preamble.
##
## v0.1 stdlib migration follow-up: real impl-block methods below
## compose against `__zag_fd_write` (always-emitted preamble helper
## in src/codegen/core.zig — emits `std.os.linux.write(fd, ...)`
## loops). `Writer.write_all(self, bytes)` is the canonical
## impl that surfaces as the migrated method body across the
## @import route. Snake_case method names match the codegen
## router emit (`__zag_Writer.std_out()` / `__zag_Writer.std_err()`).
##
## Parser rule (scaffold_tests at lib/std/fmt.zag:9 surfaced this):
## zag rejects `//` line comments at module-level scope — only
## `##` doc comments are accepted there. The in-impl `//` comment
## block previously written before `pub fun print` was removed
## in this iteration (the `##` block above is the new module-level
## rationale + carries migration context).

import std.mem.{memcpy}

pub trait Display {
    fun write(self: *const Self, writer: *Writer);
}

pub struct Writer {
    fd: i32,
}

## Real impl — `std_out` / `std_err` construct a Writer with the
## canonical POSIX stdout/stderr fd (1/2). `write_all` delegates to
## the always-emitted `__zag_fd_write` primitive in the generated
## zig preamble (see src/codegen/core.zig); `print` is documented
## as a Phase 2 widening — today's v1 surface uses
## Writer.write_all with pre-formatted bytes.
impl Writer {
    pub fun std_out() -> Writer {
        return Writer { fd: 1 };
    }

    pub fun std_err() -> Writer {
        return Writer { fd: 2 };
    }

    pub fun write_all(self: *const Writer, bytes: []const u8) -> void {
        __zag_fd_write(self.fd, bytes);
    }

    pub fun print(self: *const Writer, fmt: str) -> void {
        _ = self;
        _ = fmt;
    }
}

pub enum FmtError {
    Overflow,
    Invalid,
}

## Number formatting + parsing (strconv-style free fns).
##
##   import std.fmt.{format_u64, format_i64, parse_u64, parse_i64}
##
##   let s: []u8 = format_u64(255, 16);    # "ff" — heap slice, caller frees
##   let n: ?u64 = parse_u64("1234");      # Some(1234), null on invalid
##
## The formatters return heap-allocated slices (caller owns them —
## `defer free(s)`), matching std.encoding's convention and bench
## accounting. Parsers return Option — null on empty/invalid input
## and on i64/u64 overflow (checked before the multiply, so no
## panic).

pub fun format_u64(value: u64, base: u32) -> []u8 {
    var buf: [64]u8 = undefined;
    var n: usize = 0;
    var v: u64 = value;
    if (v == 0) {
        buf[0] = '0';
        n = 1;
    } else {
        while (v > 0) {
            let d: u64 = v % (base as u64);
            v = v / (base as u64);
            if (d < 10) {
                buf[n] = (d as u8) + '0';
            } else {
                buf[n] = ((d - 10) as u8) + 'a';
            }
            n = n + 1;
        }
    }
    var i: usize = 0;
    while (i < n / 2) {
        let t: u8 = buf[i];
        buf[i] = buf[n - 1 - i];
        buf[n - 1 - i] = t;
        i = i + 1;
    }
    let out: *raw u8 = __zag_page_alloc(n);
    __zag_bench_alloc(n);
    memcpy(out[0..n], buf[0..n], n);
    return out[0..n];
}

pub fun format_i64(value: i64, base: u32) -> []u8 {
    if (value < 0) {
        let mag: u64 = (0 - value) as u64;
        let digits: []u8 = format_u64(mag, base);
        let out: *raw u8 = __zag_page_alloc(digits.len + 1);
        __zag_bench_alloc(digits.len + 1);
        out[0] = '-';
        memcpy(out[1 .. digits.len + 1], digits[0..], digits.len);
        free(digits);
        return out[0 .. digits.len + 1];
    }
    return format_u64(value as u64, base);
}

pub fun parse_u64(s: []const u8) -> ?u64 {
    if (s.len == 0) { return null; }
    var result: u64 = 0;
    var i: usize = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c < '0' || c > '9') { return null; }
        if (result > 1844674407370955161) { return null; }
        result = result * 10 + ((c - '0') as u64);
        i = i + 1;
    }
    return result;
}

pub fun parse_i64(s: []const u8) -> ?i64 {
    if (s.len == 0) { return null; }
    var neg: bool = false;
    var i: usize = 0;
    if (s[0] == '-') { neg = true; i = 1; }
    if (s[0] == '+') { i = 1; }
    if (i >= s.len) { return null; }
    var result: i64 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c < '0' || c > '9') { return null; }
        if (result > 922337203685477580) { return null; }
        result = result * 10 + ((c - '0') as i64);
        i = i + 1;
    }
    if (neg) { return 0 - result; }
    return result;
}
