## std.fmt — Display trait + Writer sink + formatting helpers.
##
## Writer wraps a file descriptor and provides write_all/print.
## Display is the canonical formatting trait.
## __zag_format_val converts any value to a stack-allocated string.
##
## Backed by __zag_Writer in the generated zig preamble.
##
## v0.1 stdlib migration follow-up: real impl-block methods below
## compose against `__zag_fd_write` (always-emitted preamble helper
## in src/codegen/core.zig — emits `std.os.linux.write(fd, ...)`
## loops). `Writer.write_all(self, bytes)` is the canonical
## impl that surfaces as the migrated method body across the
## @import route. Snake_case method names match the codegen
## router emit (`__zag_Writer.std_out()` / `__zag_Writer.std_err()`).
##
## Parser rule (scaffold_tests at lib/std/fmt.zag:9 surfaced this):
## zag rejects `//` line comments at module-level scope — only
## `##` doc comments are accepted there. The in-impl `//` comment
## block previously written before `pub fun print` was removed
## in this iteration (the `##` block above is the new module-level
## rationale + carries migration context).

import std.mem.{memcpy, alloc_raw}
pub import std.io.{write_all as fd_write_all}

pub trait Display {
    fun write(self: *const Self, writer: *Writer);
}

pub struct Writer {
    fd: i32,
}

## Real impl — `std_out` / `std_err` construct a Writer with the
## canonical POSIX stdout/stderr fd (1/2). `write_all` delegates to
## the always-emitted `__zag_fd_write` primitive in the generated
## zig preamble (see src/codegen/core.zig); `print` is documented
## as a Phase 2 widening — today's v1 surface uses
## Writer.write_all with pre-formatted bytes.
impl Writer {
    pub fun std_out() -> Writer {
        return Writer { fd: 1 };
    }

    pub fun std_err() -> Writer {
        return Writer { fd: 2 };
    }

    pub fun write_all(self: *const Writer, bytes: []const u8) -> void {
        # Backed by std.io.write_all (lib/std/io.zag) — the
        # __zag_fd_write preamble helper retired into pure .zag in the
        # self-hosting batch. The alias `fd_write_all` keeps this body
        # a one-liner while leaving io.write_all's public name intact.
        fd_write_all(self.fd, bytes);
    }

    pub fun print(self: *const Writer, fmt: str) -> void {
        _ = self;
        _ = fmt;
    }
}

pub enum FmtError {
    Overflow,
    Invalid,
}

## Number formatting + parsing (strconv-style free fns).
##
##   import std.fmt.{format_u64, format_i64, parse_u64, parse_i64}
##
##   let s: []u8 = format_u64(255, 16);    # "ff" — heap slice, caller frees
##   let n: ?u64 = parse_u64("1234");      # Some(1234), null on invalid
##
## The formatters return heap-allocated slices (caller owns them —
## `defer free(s)`), matching std.encoding's convention and bench
## accounting. Parsers return Option — null on empty/invalid input
## and on i64/u64 overflow (checked before the multiply, so no
## panic).

pub fun format_u64(value: u64, base: u32) -> []u8 {
    var buf: [64]u8 = undefined;
    var n: usize = 0;
    var v: u64 = value;
    if (v == 0) {
        buf[0] = '0';
        n = 1;
    } else {
        while (v > 0) {
            let d: u64 = v % (base as u64);
            v = v / (base as u64);
            if (d < 10) {
                buf[n] = (d as u8) + '0';
            } else {
                buf[n] = ((d - 10) as u8) + 'a';
            }
            n = n + 1;
        }
    }
    var i: usize = 0;
    while (i < n / 2) {
        let t: u8 = buf[i];
        buf[i] = buf[n - 1 - i];
        buf[n - 1 - i] = t;
        i = i + 1;
    }
    let out: *raw u8 = alloc_raw(n);
    memcpy(out[0..n], buf[0..n], n);
    return out[0..n];
}

pub fun format_i64(value: i64, base: u32) -> []u8 {
    if (value < 0) {
        let mag: u64 = (0 - value) as u64;
        let digits: []u8 = format_u64(mag, base);
        let out: *raw u8 = alloc_raw(digits.len + 1);
        out[0] = '-';
        memcpy(out[1 .. digits.len + 1], digits[0..], digits.len);
        free(digits);
        return out[0 .. digits.len + 1];
    }
    return format_u64(value as u64, base);
}

pub fun parse_u64(s: []const u8) -> ?u64 {
    if (s.len == 0) { return null; }
    var result: u64 = 0;
    var i: usize = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c < '0' || c > '9') { return null; }
        if (result > 1844674407370955161) { return null; }
        result = result * 10 + ((c - '0') as u64);
        i = i + 1;
    }
    return result;
}

pub fun parse_i64(s: []const u8) -> ?i64 {
    if (s.len == 0) { return null; }
    var neg: bool = false;
    var i: usize = 0;
    if (s[0] == '-') { neg = true; i = 1; }
    if (s[0] == '+') { i = 1; }
    if (i >= s.len) { return null; }
    var result: i64 = 0;
    while (i < s.len) {
        let c: u8 = s[i];
        if (c < '0' || c > '9') { return null; }
        if (result > 922337203685477580) { return null; }
        result = result * 10 + ((c - '0') as i64);
        i = i + 1;
    }
    if (neg) { return 0 - result; }
    return result;
}

## Float parsing + formatting — the __zag_atof / __zag_ftoa preamble
## helpers retired into pure .zag (self-hosting batch). The zig
## preamble shims existed only because .zag couldn't spell float<->int
## casts; `x as u64` now lowers to `@as(T, @intFromFloat(x))` and
## `(d as f64)` handles the int-to-float direction, so the same
## algorithms live here where users (and std.json) can read them.
##
##   import std.fmt.{format_f64, parse_f64}
##
##   let buf: [32]u8 = undefined;
##   let n: usize = format_f64(3.5, buf[0..]);   # "3.500000"
##   let v: f64 = parse_f64("2.25e1");           # 22.5
##
## parse_f64 scans sign / integer / fraction / e-E exponent (the same
## grammar json.zag's number scanner produces). format_f64 writes
## integer digits, '.', then 6 fractional digits into `buf`,
## returning the byte length (truncated at buf.len).

pub fun parse_f64(s: []const u8) -> f64 {
    var i: usize = 0;
    var neg: bool = false;
    if (i < s.len && (s[i] == '-' || s[i] == '+')) {
        neg = s[i] == '-';
        i = i + 1;
    }
    var result: f64 = 0.0;
    while (i < s.len && s[i] >= '0' && s[i] <= '9') {
        result = result * 10.0 + ((s[i] - '0') as f64);
        i = i + 1;
    }
    if (i < s.len && s[i] == '.') {
        i = i + 1;
        var scale: f64 = 0.1;
        while (i < s.len && s[i] >= '0' && s[i] <= '9') {
            result = result + ((s[i] - '0') as f64) * scale;
            scale = scale * 0.1;
            i = i + 1;
        }
    }
    if (i < s.len && (s[i] == 'e' || s[i] == 'E')) {
        i = i + 1;
        var eneg: bool = false;
        if (i < s.len && (s[i] == '-' || s[i] == '+')) {
            eneg = s[i] == '-';
            i = i + 1;
        }
        var exp: i32 = 0;
        while (i < s.len && s[i] >= '0' && s[i] <= '9') {
            exp = exp * 10 + ((s[i] - '0') as i32);
            i = i + 1;
        }
        if (eneg) { exp = 0 - exp; }
        while (exp > 0) { result = result * 10.0; exp = exp - 1; }
        while (exp < 0) { result = result * 0.1; exp = exp + 1; }
    }
    if (neg) { return 0.0 - result; }
    return result;
}

pub fun format_f64(value: f64, buf: []u8) -> usize {
    var v: f64 = value;
    var neg: bool = false;
    if (v < 0.0) {
        neg = true;
        v = 0.0 - v;
    }
    var int_part: u64 = v as u64;
    var frac: f64 = v - (int_part as f64);
    var pos: usize = 0;
    if (neg) {
        if (pos < buf.len) { buf[pos] = '-'; }
        pos = pos + 1;
    }
    var digits: [32]u8 = undefined;
    var nd: usize = 0;
    if (int_part == 0) {
        digits[0] = '0';
        nd = 1;
    } else {
        while (int_part > 0) {
            digits[nd] = ((int_part % 10) as u8) + '0';
            nd = nd + 1;
            int_part = int_part / 10;
        }
    }
    var d: usize = nd;
    while (d > 0) {
        d = d - 1;
        if (pos < buf.len) { buf[pos] = digits[d]; }
        pos = pos + 1;
    }
    if (pos < buf.len) { buf[pos] = '.'; }
    pos = pos + 1;
    var k: usize = 0;
    while (k < 6) {
        frac = frac * 10.0;
        let digit: u64 = frac as u64;
        frac = frac - (digit as f64);
        if (pos < buf.len) { buf[pos] = (digit as u8) + '0'; }
        pos = pos + 1;
        k = k + 1;
    }
    return pos;
}
