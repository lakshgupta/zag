## std.fs — file system read.
##
## v0.1 stdlib migration status (this file):
##
##   `read_file` — REAL impl. Backed by the lib/std/posix.zag syscall
##   facade (v0.3 syscall-FFI migration — the __zag_posix preamble
##   family from src/codegen/core.zig retired into posix.zag):
##     openat(dirfd, path, flags, mode) -> Result(i32, Errno)
##     read_full(fd, buf)              -> Result(usize, Errno)
##     close(fd)                       -> Result(void, Errno)
##   After this migration, `pub import std.fs.{read_file}` resolves to
##   this real function via the @import + per-selector alias emitted by
##   src/codegen/core.zig's imports loop (Option A fallthrough — when
##   stdlibPreambleName(sel.name) returns "" the import-routing path
##   emits `const __zag_imported_<i> = @import("lib/std/fs.zag")`
##   plus `const read_file = __zag_imported_<i>.read_file` rather than
##   dropping the selector silently).
##   Chunked-read approach (v0.1): no fstat / lseek in the posix
##   facade, so we don't precompute total size. Each read loop
##   iterates 4 KiB at a time and `push_str`-es into a heap
##   `String` until read returns 0 (EOF) or negative (errno).
##   The `String` accumulator comes from `String.with_capacity` in
##   lib/std/types.zag's String, itself backed by std.mem's
##   pure-zag mmap allocator (the __zag_page_alloc preamble helper
##   retired in the v0.5 self-hosting batch) — same heap ownership
##   contract as before.
##
##   P2 (File rebuild) note: read_file owns the read loop, via
##   File.open + try_read. write_file is that loop's write twin,
##   over File.open(path, FileMode.Create) + close_durable. Every
##   fallible entry point returns Result(_, Error) and the panicking
##   duplicates are retired in favor of the postfix `!` operator, so
##   each operation has exactly one spelling; see the File section
##   below for the retained-parent-directory durability contract.
##
##   Error model: openat / read errno values (returned as
##   high-bit-set usize / negative isize respectively) collapse into
##   `__zag_panic(...)` today. v1 keeps the surface simple: any open
##   or read failure panics. (Landed in the P0/P1/P2 batches:
##   `read_file` returns Result(String, Error), the posix tier
##   decodes every errno, and nothing in this file tests a sign bit.)
##   EINTR (errno 4) is the one exception to "panic on errno": a read
##   interrupted by a signal before transferring bytes is retried, not
##   treated as a failure. Every OTHER negative read return panics —
##   pre-fix, `n_signed <= 0` broke the loop on errno too, so a mid-file
##   read error (EIO, EBADF) silently returned a truncated String.
##
##   `write_file` + `mkdir` — REAL impls (v0.1 Tier-1 migration).
##   write_file is backed by the posix facade's openat / write /
##   close; mkdir by mkdirat. The former `fs_write_file` /
##   `fs_mkdir` codegen-router rows (which REWROTE call sites into
##   per-call `blk: { ... }` shapes) were retired — call sites now
##   resolve through the imports-loop alias to these real functions,
##   mirroring read_file's path.
##
## String import: see the inline `pub import std.types.{String}`
## just below -- needed so project-mode `zag generate` parses
## fs.zag in isolation without an ambient std namespace.
##
## Contract change (v0.1, superseded by P2): the reader returns a
## `String`, NOT `[]u8` + Result-as-Optional like the pre-migration
## codegen-router inline emit, so the String ergonomics removed the
## heap page_allocator.free obligation. The recoverable reader is
## `read_file(path) -> Result(String, Error)`; the fail-fast
## spelling is `read_file("X")!`, and match on the Result when the
## failure needs a policy. The examples/stdlib/fs.zag fixture
## demonstrates both.
##
## Zombie-alias note (historical): the imports-loop Option A
## fallthrough emits `const write_file = __zag_imported_<i>.write_file;`
## and `const mkdir = __zag_imported_<i>.mkdir;` whenever any selector
## of a lib/std/fs.zag import lacks a preamble-equivalent name. During
## the router-only era these aliases compiled but were never invoked
## (the router rewrote call sites into per-call `blk: { ... }` shapes).
## With write_file + mkdir now REAL impls, the aliases are live call
## targets — the migration made the dead bindings load-bearing.

## Bring String into scope for fs.zag's body. Without this
## explicit import, project-mode `zag generate` parses fs.zag in
## isolation and rejects `String.with_capacity(...)` with "use of
## undeclared identifier 'String'". The pre-migration stub worked
## because its throwaway body referenced String-OBLIVIOUS slice
## syntax; the post-migration real impl exercises String directly.
pub import std.types.{String}

## Canonical error enum for the recoverable (Result-returning) IO
## surface below — `read_file` / `try_read` collapse errno into
## these variants so callers can branch instead of aborting.
pub import std.error.{Error}

## Syscall facade import (v0.3 syscall-FFI migration): the openat
## family now lives in lib/std/posix.zag, not the preamble. The
## selective list binds openat / read / write / close / mkdirat —
## the five entries this file's real impls route through. Reading
## against the retired __zag_openat / __zag_read / __zag_write /
## __zag_close / __zag_mkdirat names is the regression signal.
##   The selective list now binds the Result-returning transfer helpers
##   (read_some / read_full / write_full / pread_some / pwrite_full) plus
##   openat/close/mkdirat/lseek/ftruncate/fsync/fdatasync. Under the P1
##   posix tier split every one of those publishes `Result(_, Errno)`,
##   so this file no longer contains a single sign-bit test: each site
##   either propagates the `Err` or panics through `__zag_panic`, and
##   the errno is a named value by the time it gets here.
##   The bare read/write/pread/pwrite bindings are gone: every transfer
##   in this file goes through a helper that already owns the EINTR
##   retry and the short-transfer loop, so there is no raw byte loop
##   left here.
##   `read_full` left this list with P2: read_file no longer owns a
##   chunked drain loop (read_file's loop goes through try_read, i.e.
##   read_some), so the whole-slice helper has no caller here any more.
pub import std.posix.{openat, close, close as posix_close, mkdirat, lseek, ftruncate, fsync, fdatasync, read_some, write_full, pread_some, pwrite_full}
import std.errno.{Errno, ErrnoKind}
## std.mem.memcpy — used by `file_init` below to retain the parent
## directory of an opened path inside the File handle. The P2 rebuild
## made the handle own that copy; pre-P2 no array lived in a File.
import std.mem.{memcpy}

## (Historical: the panicking `read_file(path) -> String` spelling used
## to live here beside a `read_file_or` twin. Both are gone: `read_file`
## now returns `Result(String, Error)` and `read_file(path)!` is the
## fail-fast form, so the library publishes one reader instead of two
## names that must be kept in step. `!` is the panicking mirror of `?`
## (docs/manual/19), which is what replaced the `_or` / `*_or_panic`
## naming convention.)

## ── Recoverable IO (Result-returning) ────────────────────────────────
##
## `read_file` returns `Result(String, Error)` and never panics on IO
## failure, so a caller can distinguish "missing" from "permission
## denied" and keep going — or write `read_file(path)!` to panic, or `?`
## to propagate. The failure policy is spelled at the CALL SITE, so
## there is exactly one reader. `try_read` is the sibling fd-level
## primitive — one errno-aware read, for streaming callers; both share
## the `io_error` mapping below, which is the only thing left to decide
## (the errno itself arrives already decoded from std.posix's Result
## tier).
##
## errno collapses to the canonical std.error.Error variants:
##   ENOENT(2)          -> Error.NotFound
##   EPERM(1)/EACCES(13)-> Error.Permission
##   everything else    -> Error.Io

## io_error — map a positive errno to the canonical Error variant.
fun io_error(errno: isize) -> Error {
    if (errno == 2) { return Error.NotFound; }
    if (errno == 1) { return Error.Permission; }
    if (errno == 13) { return Error.Permission; }
    return Error.Io;
}

## (The private `errno_of(usize)` decoder that used to sit here is gone:
## the errno now arrives already decoded, as `Errno` values from
## std.posix, so nothing in this file inspects a sign bit.)

## try_read — one errno-aware `read(2)` into `buf`. Returns `Ok(n)`
## with the byte count (0 at EOF), `Err(e)` on failure, and retries
## EINTR (a signal interrupting the syscall before any bytes moved).
## The recoverable counterpart of the panicking whole-file path.
pub fun try_read(fd: i32, buf: []u8) -> Result(usize, Error) {
    # read_some is the single-transfer read with EINTR already retried;
    # the only work left here is collapsing its Errno into the canonical
    # std.error.Error this entry point publishes.
    let r: Result(usize, Errno) = read_some(fd, buf);
    let out: Result(usize, Error) = match r {
        Ok(n) => Ok(n),
        Err(e) => Err(io_error(e.code)),
    };
    return out;
}

## EINTR-safe positioned/streaming wrappers for the File handle below
## used to live here (pread_retry / pwrite_retry / write_retry). They
## moved to std.posix as pread_some / pwrite_full / write_full, which
## are the same loops with the errno decode shared with io.zag and
## random.zag instead of duplicated per module.

## read_file — whole-file read over the chunked 4 KiB loop. Every
## failure routes to `Err` instead of `__zag_panic`; the fail-fast form
## is `read_file(path)!`. The returned String is heap-owned by the
## caller, which releases it with `s.deinit()` (lib/std/types/string.zag).
## The initial capacity is one 4 KiB chunk, so a small file still charges
## 4096 live bytes until that `deinit` — the leak ledger reports the
## mapping, not the byte count.
pub fun read_file(path: str) -> Result(String, Error) {
    # File.open is the one open path now (it also retains the parent
    # directory), so the recoverable reader goes through the handle
    # rather than hand-rolling its own openat. A missing file is
    # therefore Err(NotFound) from exactly the same place `File.open`
    # reports it.
    let fr: Result(File, Error) = File.open(path, FileMode.Read);
    if let Err(e) = fr {
        return Err(e);
    }
    var f: File = File { fd: (0 - 1), parent: undefined, parent_len: 0, created: false };
    if let Ok(v) = fr { f = v; }

    var sb: String = String.with_capacity(4096);
    var stack_buf: [4096]u8 = undefined;
    while (true) {
        # Reuse try_read so the EINTR retry / errno decode lives in
        # exactly one place. The Ok arm `break`s the loop (and the Err
        # arm `return`s) directly from inside the match — the codegen
        # keeps those as real control flow rather than folding them
        # into the match's value.
        let r: Result(usize, Error) = try_read(f.fd, stack_buf[0..stack_buf.len]);
        match r {
            Ok(n) => {
                if (n == 0) { break; }
                sb.push_str(stack_buf[0..n]);
            },
            Err(e) => {
                # The read errno is the primary failure and the caller
                # needs it; a close error on a read-only descriptor
                # cannot improve the report, so this discard is
                # deliberate and is the only one in the function.
                _ = f.close(); # deliberate discard: read-only fd; the read errno is the primary failure.
                return Err(e);
            },
        }
    }
    # The close is checked on the success path: a deferred error on a
    # read-only fd is unlikely (NFS, a revoked mount) but it is a real
    # failure, and `read_file` reports failures as values.
    let cr: Result(void, Error) = f.close();
    if let Err(e) = cr { return Err(e); }
    return Ok(sb);
}

## dir_of — the parent directory of `path`, for the directory-fsync
## step below. `"a/b/c.txt"` → `"a/b"`; `"file.txt"` → `"."`;
## `"/x"` → `"/"`. Trailing slashes are trimmed first. Only ever
## called after `path` opened successfully, so `path` names a regular
## file (a trailing-slash directory path never reaches here).
fun dir_of(path: str) -> str {
    var end: usize = path.len;
    while (end > 0 && path[end - 1] == '/') { end = end - 1; }
    var i: usize = end;
    while (i > 0) {
        if (path[i - 1] == '/') {
            if (i == 1) { return "/"; }
            return path[0..i - 1];
        }
        i = i - 1;
    }
    return ".";
}

## (Historical: `write_file` started as a v0.1 Tier-1 migration with the
## whole sequence — openat, write loop, fsync, checked close, parent
## fsync — written out inline here, on top of the posix facade that had
## retired the __zag_openat/__zag_write/__zag_close preamble family.
## The P2 rebuild moved that sequence into `File.open(_, FileMode.Create)` +
## `write_full` + `close_durable`, so what remains below is the policy
## layer; the flags and the durability rules are unchanged.)

## write_file — the durable write, and since P2 the one
## implementation of the whole sequence: create the handle, write every
## byte, then `close_durable` (fsync contents -> checked close ->
## directory fsync when the handle created the entry). Ok(n) is the
## byte count; every failure is an Err carrying the mapped Error.
##
## Pre-P2 this sequence was written out longhand inside `write_file`,
## which is exactly why the directory-fsync tolerance (EINVAL/ENOTSUP)
## and the "was the name created?" question had to be re-derived by
## every other writer. It now lives in `File.close_durable` once.
pub fun write_file(path: str, content: []const u8) -> Result(usize, Error) {
    let fr: Result(File, Error) = File.open(path, FileMode.Create);
    if let Err(e) = fr { return Err(e); }
    var f: File = File { fd: (0 - 1), parent: undefined, parent_len: 0, created: false };
    if let Ok(v) = fr { f = v; }

    # write_full loops until the whole slice lands (write(2) may write
    # fewer bytes than asked) and retries EINTR rather than reporting a
    # spurious short write. Ok means every byte landed; Err is a real
    # errno, so a partial write can no longer read as success.
    let wr: Result(usize, Errno) = write_full(f.fd, content);
    if let Err(e) = wr {
        # The write errno is the primary failure; a close error on the
        # way out cannot improve the report. Deliberate discard.
        _ = f.close(); # deliberate discard: the write errno being returned is the primary failure; a close error cannot improve it.
        return Err(io_error(e.code));
    }
    var n: usize = 0;
    if let Ok(v) = wr { n = v; }

    # Durability barrier BEFORE reporting success: a buffered write can
    # return full-length while the real failure (ENOSPC / EIO) only
    # surfaces at fsync time, and close(2) can report a deferred write
    # error of its own.
    let cr: Result(void, Error) = f.close_durable();
    if let Err(e) = cr { return Err(e); }
    return Ok(n);
}

## (Historical: `write_file(path, content) -> i32` — the same durable
## write with its Error collapsed to -1 — and `mkdir(path) -> i32` both
## lived here. The i32 convention is retired: a caller that wants the
## fail-fast form writes `write_file(path, content)!`, and a caller
## that wants to report the failure matches the `Result`. Keeping a
## second, weaker failure channel for the same condition is exactly the
## ambiguity P2 removed from the File handle.)

## mkdir — `mkdir -p` semantics: a single mkdirat(2) with mode 0o755
## where EEXIST is a SUCCESS (the postcondition "the directory exists"
## already holds). Every other errno comes back as `Error`; a caller
## that wants to ignore failures writes `mkdir(path)!` and one that
## wants to branch matches the value.
pub fun mkdir(path: str) -> Result(void, Error) {
    let r: Result(void, Errno) = mkdirat(std.posix.AT.FDCWD, path, 0o755);
    if let Err(e) = r {
        # EEXIST comes back as a typed value, so the mkdir -p coalesce
        # is a named comparison instead of `errno_val == 17` on a
        # hand-negated i64.
        if e.is(ErrnoKind.Eexist) { return Ok(undefined); }
        return Err(io_error(e.code));
    }
    return Ok(undefined);
}

## ── File: a positioned handle for block/page I/O ──────────────────────
##
## `read_file` / `write_file` above are whole-file conveniences. A
## storage engine needs the positioned primitives instead:
##
##   let f: File = File.open("db.pages", FileMode.Create)!;
##   var page: [PAGE_SIZE]u8 = undefined;
##   f.write_block(0, page[0..])!;   # write page 0
##   _ = f.read_block(0, page[0..])!; # read it back
##   f.sync()!;                      # durable
##   _ = f.close_durable()!;
##
## ...and when the failure needs a policy other than panic, the SAME
## method returns the Result (this is what the `!` operator replaces the
## `*_or_panic` name family with):
##
##   let cr: Result(File, Error) = File.open("db.pages", FileMode.Create);
##   match cr {
##       Ok(v) => { f = v; },
##       Err(e) => print("create failed\n"),
##   }
##
## Why the p-variants (pread/pwrite) rather than seek+read/write:
## they take the offset as an argument and leave the fd's file
## position untouched, so a page read can never be corrupted by
## another writer advancing the position — and there's no seek
## syscall on the hot path.
##
## PAGE_SIZE (4096) is the unit every block method works in: the
## page is the transfer unit of the disk and of the OS page cache,
## so a storage engine that reads and writes whole pages gets the
## cache's behaviour for free.
##
## ── Contract (P2 rebuild of the File handle) ──────────────────────────
##
## Every fallible method returns Result(_, Error), and the errno has
## already been decoded by std.posix's Result tier by the time it gets
## here — this file contains no sign-bit test. There is exactly ONE
## spelling of each operation: the `*_or_panic` twins are GONE.
## A failure that is a bug in the program is expressed by the caller
## with the postfix `!` operator (`f.sync()!`), the propagate form with
## `?`, a fallback with `catch`, and a branch with `match` — so the
## failure policy is visible at the call site instead of encoded in the
## callee's name, and no name pair can drift out of step. `try_open` is
## GONE for the same reason: `open` returns a Result now, so the
## `fd == -1` sentinel could only be a second, weaker failure channel
## for the same condition.
##
## The handle RETAINS ITS PARENT DIRECTORY so durability is built in
## rather than bolted onto write_file:
##
##   * `parent` / `parent_len` — the parent directory of the path the
##     handle was opened with, captured at open time via `dir_of`. A
##     parent longer than PARENT_CAP is not retained (`parent_len`
##     stays 0), and `fsync_parent` then reports Err rather than
##     promising a durability it cannot deliver.
##   * `created` — true when the handle was opened with O_CREAT, i.e.
##     the directory ENTRY may need flushing and not just the file's
##     bytes. That is what makes `close_durable`'s directory fsync
##     conditional instead of a fsync on every close.
##   * `close_durable` = fsync contents + checked close + (if created)
##     fsync the parent. `close` is the plain checked close: fast, and
##     it never silently fsyncs.
##
## Move-only by convention: `File` crosses the ABI by value, and
## `close`/`close_durable` invalidate the handle (fd -> -1). Two live
## copies of one File would double-close. `is_open()` probes that
## state, and closing an already-closed handle is Ok(undefined) — the
## postcondition already holds.

## Open-flag bits for Linux x86-64 — openat takes the raw bitmask.
const O_RDONLY: u32 = 0;
const O_WRONLY: u32 = 1;
const O_RDWR: u32 = 2;
const O_CREAT: u32 = 0x40;
const O_TRUNC: u32 = 0x200;
const O_APPEND: u32 = 0x400;

## Open mode for `File.open(path, mode)`. One name with a mode
## argument replaces the four `open` / `open_rw` / `open_append` /
## `create` constructors: the mode is explicit at the call site, and a
## future mode is a variant rather than a new name.
##   Read   = O_RDONLY                    read-only (must exist)
##   Rw     = O_RDWR | O_CREAT            read-write, create if missing
##   Append = O_WRONLY | O_CREAT | O_APPEND   atomic append (WAL)
##   Create = O_RDWR | O_CREAT | O_TRUNC  start a new database
##
## The mode is MANDATORY (there is no `File.open(path)` one-argument
## overload) because `File` is a cross-module type: method overloading
## resolves against the type's own `impl` table, which the *calling*
## module cannot see when the type lives in an imported module
## (docs/manual/30 §"Across modules"). A single explicit signature is
## the spelling that works from every module.
pub enum FileMode {
    Read,
    Rw,
    Append,
    Create,
}

## The page size, exported with `pub` so importers can size their own
## page buffers from it (`import std.fs.{PAGE_SIZE}`).
pub const PAGE_SIZE: usize = 4096;

## Longest parent directory path retained inside a File handle. A path
## whose parent is longer still opens — the kernel accepts up to
## PATH_MAX (4096) — but the parent is not retained and `fsync_parent`
## reports Err. 512 covers every path a build tool realistically hands
## to a handle while keeping the value small enough to pass by value.
pub const PARENT_CAP: usize = 512;

## Fields:
##   fd         — the open descriptor, or -1 once closed
##   parent     — parent directory of the opened path (raw bytes, not
##                sentinel-terminated; std.posix.openat does the copy)
##   parent_len — bytes of `parent` in use; 0 means "not retained"
##   created    — opened with O_CREAT, so the directory entry may need
##                flushing
pub struct File {
    fd: i32,
    parent: [PARENT_CAP]u8,
    parent_len: usize,
    created: bool,
}

impl File {
    ## The one constructor: `open(path, mode)` covers read-only, read-
    ## write, append, and create/truncate (`FileMode`). One name with an
    ## explicit mode replaces four constructor names; the caller picks
    ## the failure policy at the call site — `File.open(p, FileMode.Create)!`
    ## panics, `?` propagates, `catch` supplies a fallback, `match`
    ## branches. The mode is mandatory because `File` is cross-module
    ## (see `FileMode`): a one-argument overload could not resolve from
    ## an importing module.
    pub fun open(path: str, mode: FileMode) -> Result(File, Error) {
        if (mode == FileMode.Read) {
            return open_flags(path, O_RDONLY, 0, false);
        }
        if (mode == FileMode.Create) {
            return open_flags(path, O_RDWR | O_CREAT | O_TRUNC, 0o644, true);
        }
        if (mode == FileMode.Append) {
            return open_flags(path, O_WRONLY | O_CREAT | O_APPEND, 0o644, true);
        }
        return open_flags(path, O_RDWR | O_CREAT, 0o644, true);
    }

    ## True while the handle owns an open descriptor. This is the probe
    ## that replaced `try_open`'s `fd == -1` sentinel.
    pub fun is_open(self: *File) -> bool {
        return self.fd >= 0;
    }

    ## Read up to `buf.len` bytes at absolute offset `off`. Ok(n) with
    ## the count read (0 at EOF; short reads are legal).
    pub fun read_at(self: *File, buf: []u8, off: i64) -> Result(usize, Error) {
        let r: Result(usize, Errno) = pread_some(self.fd, buf, off);
        return map_count(r);
    }
    ## Write `bytes` at absolute offset `off`, looping until all of it
    ## lands (pwrite may write less than asked). Ok(n) is the number of
    ## bytes written — always `bytes.len` on success.
    pub fun write_at(self: *File, bytes: []const u8, off: i64) -> Result(usize, Error) {
        let r: Result(usize, Errno) = pwrite_full(self.fd, bytes, off);
        return map_count(r);
    }
    ## Read one whole page. `buf` must be exactly PAGE_SIZE — anything
    ## else is Err(Error.InvalidInput), a contract violation reported
    ## as a value rather than a panic. Ok(true) when a whole page was
    ## read; Ok(false) when the page is past EOF (a short read means a
    ## partially written page — treat it as absent rather than parsing
    ## garbage), with the tail zero-filled.
    pub fun read_block(self: *File, block_id: u64, buf: []u8) -> Result(bool, Error) {
        if (buf.len != PAGE_SIZE) {
            return Err(Error.InvalidInput);
        }
        let rr: Result(usize, Error) = self.read_at(buf, (block_id * (PAGE_SIZE as u64)) as i64);
        if let Err(e) = rr { return Err(e); }
        var n: usize = 0;
        if let Ok(v) = rr { n = v; }
        if (n < PAGE_SIZE) {
            var i: usize = n;
            while (i < buf.len) {
                buf[i] = 0;
                i = i + 1;
            }
            return Ok(false);
        }
        return Ok(true);
    }
    ## Write one whole page at `block_id`. Zero-pads a short buffer to
    ## the full page so the on-disk page is always PAGE_SIZE (a short
    ## write would leave the previous contents of that page behind,
    ## which reads back as corrupt data). A payload larger than a page
    ## is Err(Error.InvalidInput).
    pub fun write_block(self: *File, block_id: u64, bytes: []const u8) -> Result(void, Error) {
        if (bytes.len > PAGE_SIZE) {
            return Err(Error.InvalidInput);
        }
        let off: i64 = (block_id * (PAGE_SIZE as u64)) as i64;
        if (bytes.len == PAGE_SIZE) {
            let wr: Result(usize, Error) = self.write_at(bytes, off);
            if let Err(e) = wr { return Err(e); }
            return Ok(undefined);
        }
        var page: [PAGE_SIZE]u8 = undefined;
        var i: usize = 0;
        while (i < bytes.len) {
            page[i] = bytes[i];
            i = i + 1;
        }
        while (i < PAGE_SIZE) {
            page[i] = 0;
            i = i + 1;
        }
        let wr2: Result(usize, Error) = self.write_at(page[0..], off);
        if let Err(e) = wr2 { return Err(e); }
        return Ok(undefined);
    }
    ## Append at the end (atomic when opened with `FileMode.Append`).
    ## Ok(n) is the byte count; write_full loops the short writes.
    pub fun append(self: *File, bytes: []const u8) -> Result(usize, Error) {
        let r: Result(usize, Errno) = write_full(self.fd, bytes);
        return map_count(r);
    }

    ## File length in bytes (lseek to end — zig 0.16's std has no fstat
    ## binding; position is restored, though pread/pwrite don't depend
    ## on it anyway).
    pub fun size(self: *File) -> Result(usize, Error) {
        let r: Result(i64, Errno) = lseek(self.fd, 0, 2);
        if let Err(e) = r { return Err(io_error(e.code)); }
        var n: i64 = 0;
        if let Ok(v) = r { n = v; }
        if (n < 0) { return Err(Error.Io); }
        return Ok(n as usize);
    }
    ## How many whole pages the file currently holds.
    pub fun block_count(self: *File) -> Result(usize, Error) {
        let sr: Result(usize, Error) = self.size();
        if let Err(e) = sr { return Err(e); }
        var n: usize = 0;
        if let Ok(v) = sr { n = v; }
        return Ok(n / PAGE_SIZE);
    }
    ## Grow or shrink the file to `n` bytes — pre-extend to N pages
    ## before writing blocks, or reset a database.
    pub fun truncate(self: *File, n: usize) -> Result(void, Error) {
        let r: Result(void, Errno) = ftruncate(self.fd, n as i64);
        return map_void(r);
    }
    ## Flush the file's contents to stable storage. A write-ahead-log
    ## record is only committed once this returns Ok.
    pub fun sync(self: *File) -> Result(void, Error) {
        let r: Result(void, Errno) = fsync(self.fd);
        return map_void(r);
    }
    ## Data-only flush (skips metadata) — cheaper than sync when the
    ## file size is already correct.
    pub fun datasync(self: *File) -> Result(void, Error) {
        let r: Result(void, Errno) = fdatasync(self.fd);
        return map_void(r);
    }
    ## Flush the DIRECTORY the file lives in, so a newly created name is
    ## durable and not just the file's bytes.
    ##
    ## Tolerated: EINVAL / ENOTSUP — some filesystems (and some network
    ## mounts) do not support fsync on a directory fd. That means "no
    ## stronger guarantee is available", not "the write failed", so it
    ## is Ok. A parent that was not retained (a path longer than
    ## PARENT_CAP) is Err: reporting Ok there would claim a durability
    ## guarantee the handle cannot deliver.
    pub fun fsync_parent(self: *File) -> Result(void, Error) {
        if (self.parent_len == 0) {
            return Err(Error.Io);
        }
        let dr: Result(i32, Errno) = openat(std.posix.AT.FDCWD, self.parent[0..self.parent_len], 0, 0);
        if let Err(e) = dr { return Err(io_error(e.code)); }
        var dfd: i32 = 0;
        if let Ok(v) = dr { dfd = v; }
        let frc: Result(void, Errno) = fsync(dfd);
        # `posix_close`, not `close`: inside `impl File` the container-
        # scoped method name `close` shadows the imported facade entry,
        # so the bare spelling is an ambiguous reference in the emitted
        # zig. That is what the `close as posix_close` selector on the
        # import line above is for.
        let crc: Result(void, Errno) = posix_close(dfd);
        if let Err(e) = frc {
            if e.is(ErrnoKind.Einval) { return Ok(undefined); }
            if e.is(ErrnoKind.Enotsup) { return Ok(undefined); }
            return Err(io_error(e.code));
        }
        if let Err(e) = crc { return Err(io_error(e.code)); }
        return Ok(undefined);
    }
    ## Plain checked close: fast, and it never silently fsyncs. A
    ## deferred writeback error (ENOSPC/EIO) can be reported ONLY here,
    ## so the result is returned instead of discarded — otherwise a
    ## failed flush reads back as "closed fine". Linux releases the fd
    ## even when close(2) fails, so the handle is marked closed FIRST;
    ## EINTR is NOT retried (the fd may already have been released and
    ## reused).
    ##
    ## Closing an already-closed handle is Ok(undefined): the
    ## postcondition (no open fd) already holds. Pair it with
    ## `close_durable` when the NAME must be durable too.
    pub fun close(self: *File) -> Result(void, Error) {
        if (self.fd < 0) {
            return Ok(undefined);
        }
        let fd: i32 = self.fd;
        self.fd = 0 - 1;
        let r: Result(void, Errno) = posix_close(fd);
        return map_void(r);
    }
    ## The durable sequence: flush the contents, close (checking for a
    ## deferred writeback error), then — when this handle CREATED the
    ## file — flush the parent directory so the new NAME is durable.
    ## `write_file` is built on this, which is why the guarantee lives
    ## in one place instead of in every writer.
    pub fun close_durable(self: *File) -> Result(void, Error) {
        if (self.fd >= 0) {
            let sr: Result(void, Error) = self.sync();
            if let Err(e) = sr { return Err(e); }
        }
        let was_created: bool = self.created;
        let cr: Result(void, Error) = self.close();
        if let Err(e) = cr { return Err(e); }
        if (was_created) {
            return self.fsync_parent();
        }
        return Ok(undefined);
    }
}

## ── Shared helpers for the File tier ─────────────────────────────────
## `open_flags` — the one open path. Records the parent directory and
## whether O_CREAT was passed, so the handle can flush its own directory
## entry later. Every constructor goes through here.
fun open_flags(path: str, flags: u32, mode: u32, created: bool) -> Result(File, Error) {
    let r: Result(i32, Errno) = openat(std.posix.AT.FDCWD, path, flags, mode);
    if let Err(e) = r { return Err(io_error(e.code)); }
    var fd: i32 = 0;
    if let Ok(v) = r { fd = v; }
    return Ok(file_init(fd, path, created));
}

## file_init — build the handle, retaining the parent directory when it
## fits in PARENT_CAP bytes. `created` is recorded regardless: when the
## parent did NOT fit, `fsync_parent` finds parent_len == 0 and reports
## Err, which is what makes `close_durable` on such a handle fail closed
## instead of silently skipping the directory flush (the handle knows it
## was created, and cannot prove the name is durable, so it says so).
fun file_init(fd: i32, path: str, created: bool) -> File {
    var f: File = File { fd: fd, parent: undefined, parent_len: 0, created: created };
    let dir: str = dir_of(path);
    if (dir.len <= PARENT_CAP) {
        memcpy(f.parent[0..dir.len], dir[0..], dir.len);
        f.parent_len = dir.len;
    }
    return f;
}

## The errno → std.error.Error boundary, in one place for every method
## above. ENOENT → NotFound, EPERM/EACCES → Permission, else Io; the
## posix tier keeps the exact code for callers that need it.
fun map_void(r: Result(void, Errno)) -> Result(void, Error) {
    if let Err(e) = r { return Err(io_error(e.code)); }
    return Ok(undefined);
}
fun map_count(r: Result(usize, Errno)) -> Result(usize, Error) {
    if let Err(e) = r { return Err(io_error(e.code)); }
    var n: usize = 0;
    if let Ok(v) = r { n = v; }
    return Ok(n);
}

## (Historical: `void_or_panic` / `count_or_panic` / `bool_or_panic` /
## `file_or_panic` — the four shims every `*_or_panic` method delegated
## its panic to — lived here. The `!` operator replaces all of them: the
## panic is spelled at the CALL SITE, so there is nothing left for a
## per-shape helper to own, and a failure message can no longer drift
## from the operation it names.)
