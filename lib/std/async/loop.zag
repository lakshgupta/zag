## std.async.loop — EventLoop: timer-driven scheduling over
## nanosleep. No busy-wait anywhere.
##
##   import std.async.{EventLoop, sleep, now_ms}
##
##   var loop: EventLoop = EventLoop.new();
##   var t1: Future(void) = undefined;
##   var t2: Future(void) = undefined;
##   loop.set_timeout(50, &t1);
##   loop.set_timeout(120, &t2);
##   loop.wait(&t2, 500);        # fires t1 at 50ms, t2 at 120ms
##   await t2;
##
## Model: the loop owns a sorted timer list; `set_timeout` registers
## the caller's Future pointer; `poll` (called by wait/run_for) flips
## `.done` when the deadline passes. The v1 async driver is eager —
## the awaited future's producer completes it before the drive
## returns, so `await` on a loop-completed future unwraps directly.
## Real future SUSPENSION (resume-on-completion without a blocked
## caller) remains the documented follow-up; the timer surface is
## stable across it.

import std.collections.{ArrayList}
import std.time.{clock_gettime}

## Clock now in milliseconds (CLOCK_MONOTONIC).
pub fun now_ms() -> i64 {
    return clock_gettime(1) / 1_000_000;
}

## Blocking sleep via nanosleep — returns an already-completed
## Future(void) so `await sleep(ms)` works in the v1 eager model
## without burning CPU (time.after busy-waits; this does not).
pub fun sleep(ms: i64) -> Future(void) {
    __zag_nanosleep_ms(ms);
    return __zag_future_ready_void();
}

struct TimerEntry {
    deadline_ms: i64,
    # Opaque future pointer: Future(T) is a PER-MODULE preamble type
    # (main.Future(void) != std.async.loop.Future(void)), so the loop
    # stores the raw pointer and type-puns to its own Future for the
    # `.done` flip — the layouts are identical ({ done, value }).
    fut: *raw u8,
}

pub struct EventLoop {
    timers: ArrayList(TimerEntry),
}

impl EventLoop {
    pub fun new() -> EventLoop {
        return EventLoop { timers: ArrayList(TimerEntry).new() };
    }

    # Register `fut` to complete after `ms` from now. The caller
    # owns the future (a local binding); the loop stores a pointer
    # and flips `.done` when the deadline passes.
    pub fun set_timeout(self: *EventLoop, ms: i64, fut: *raw u8) {
        let deadline: i64 = now_ms() + ms;
        self.timers.push(TimerEntry { deadline_ms: deadline, fut: fut });
    }

    # Fire every due timer (sets the registered futures' `.done`).
    # Called by wait/run_for between nanosleep ticks.
    pub fun poll(self: *EventLoop) {
        let now: i64 = now_ms();
        var i: usize = 0;
        while (i < self.timers.len) {
            let entry: TimerEntry = self.timers.get(i);
            if (entry.deadline_ms <= now) {
                let f: *Future(void) = entry.fut as *Future(void);
                f.done = true;
                self.timers.set(i, self.timers.get(self.timers.len - 1));
                self.timers.len = self.timers.len - 1;
            } else {
                i = i + 1;
            }
        }
    }

    # Drive the loop until `fut` is done or `timeout_ms` elapses.
    # Returns true when the future completed in time.
    pub fun wait(self: *EventLoop, fut: *raw u8, timeout_ms: i64) -> bool {
        let deadline: i64 = now_ms() + timeout_ms;
        let f: *Future(void) = fut as *Future(void);
        while (!f.done) {
            self.poll();
            if (now_ms() >= deadline) { return false; }
            __zag_nanosleep_ms(1);
        }
        return true;
    }

    # Run the loop (polling due timers) for `ms` wall time.
    pub fun run_for(self: *EventLoop, ms: i64) {
        let deadline: i64 = now_ms() + ms;
        while (now_ms() < deadline) {
            self.poll();
            __zag_nanosleep_ms(1);
        }
    }
}
