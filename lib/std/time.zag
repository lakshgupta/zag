## std.time — Duration, Timer, and time-query free functions.
##
## Duration and Timer are declared here; their bodies are real
## (self-consistent) but currently unused surface.
##
## v0.1 Tier-1 migration: `now()` is a real zag impl backed by the
## always-emitted `__zag_clock_gettime` preamble helper
## (src/codegen/core.zig, a forwarder onto `std.os.linux.clock_gettime`).
## clockid 1 = CLOCK_MONOTONIC on Linux — i64 nanoseconds since the
## monotonic epoch. The pre-migration `time_now` router row emitted
## the same syscall inline as a blk-expression; retired in the
## Tier-1 migration — this .zag body is the single source of truth.

pub fun now() -> i64 {
    return __zag_clock_gettime(1);
}

pub struct Duration {
    nanos: i64,
}

impl Duration {
    pub fun from_millis(ms: u64) -> Duration {
        return Duration { nanos: (ms as i64) * 1_000_000 };
    }
    pub fun as_millis(self: *Duration) -> u64 {
        let ms: i64 = self.nanos / 1_000_000;
        return ms as u64;
    }
}

## Async v1 (docs/manual/00-overview.md "Zero-cost async"): the
## timer surface an async fn can await on. `after(ms)` busy-waits
## on CLOCK_MONOTONIC until the duration elapses, then returns an
## already-completed Future(void) — the v1 synchronous driver runs
## the await inline (see __zag_future_drive in the preamble), so the
## sleep happens inside the call. A real event-loop timer (no
## busy-wait) is the documented follow-up alongside real future
## suspension.

pub fun after(ms: i64) -> Future(void) {
    let start: i64 = now();
    let target: i64 = start + ms * 1_000_000;
    while (now() < target) {}
    return __zag_future_ready_void();
}

pub struct Timer {
    start_ns: i64,
}

impl Timer {
    pub fun start() -> Timer {
        return Timer { start_ns: now() };
    }
    pub fun elapsed(self: *Timer) -> Duration {
        return Duration { nanos: now() - self.start_ns };
    }
}
