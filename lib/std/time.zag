## std.time — Duration, Timer, and time-query free functions.
##
## Duration and Timer are defined as real types in the generated zig preamble.
## `now()` returns `std.time.nanoTimestamp()` (i64 nanos since monotonic epoch).
##
## Methods route through the codegen router.

pub struct Duration {
    nanos: i64,
}

impl Duration {
    pub fun from_millis(ms: u64) -> Duration {
        return Duration { nanos: 0 };
    }
    pub fun as_millis(self: *Duration) -> u64 {
        return 0;
    }
}

pub struct Timer {
    start: i64,
}

impl Timer {
    pub fun start() -> Timer {
        return Timer { start: 0 };
    }
    pub fun elapsed(self: *Timer) -> Duration {
        return Duration { nanos: 0 };
    }
}
