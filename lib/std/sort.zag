## std.sort — sorting and searching over slices (generic free fns).
##
## Generic functions use the turbofish call-site form (docs/16 §1):
##
##   import std.sort.{sort, binary_search}
##
##   var arr: [5]i32 = { 5, 2, 4, 1, 3 };
##   sort<i32>(arr[0..]);
##   let idx: ?usize = binary_search<i32>(arr[0..], 4);   # Some(3)
##
## `sort` is insertion sort — O(n²) worst case but stable, in-place,
## and allocation-free; the right default for small slices. A
## merge/heap sort is a follow-up once generic structs land.

pub fun sort<T>(arr: []T) {
    let n: usize = arr.len;
    if (n <= 1) { return; }
    var i: usize = 1;
    while (i < n) {
        var j: usize = i;
        while (j > 0 && arr[j - 1] > arr[j]) {
            let tmp: T = arr[j];
            arr[j] = arr[j - 1];
            arr[j - 1] = tmp;
            j = j - 1;
        }
        i = i + 1;
    }
}

## Binary search over a SORTED slice. Returns the index of an element
## equal to `target`, or null when absent.
pub fun binary_search<T>(arr: []const T, target: T) -> ?usize {
    var lo: usize = 0;
    var hi: usize = arr.len;
    while (lo < hi) {
        let mid: usize = lo + (hi - lo) / 2;
        if (arr[mid] == target) {
            return mid;
        }
        if (arr[mid] < target) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return null;
}
