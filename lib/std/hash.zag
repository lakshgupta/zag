## std.hash — non-cryptographic + SHA-256 hashes over byte slices.
##
## All functions are pure free fns returning the digest by value
## (u32 / u64 / [32]u8) — no allocation.
##
##   import std.hash.{fnv1a32, fnv1a64, crc32, sha256}
##
## Wrapping arithmetic: zag's `+%`/`*%` (docs/manual/05-operators.md
## §Wrapping Arithmetic) lower to zig's wrapping operators, so the
## digests accumulate natively in the digest-width type (u32 / u64)
## with mod-2^N wrap semantics — no widen-and-fold needed. The
## pre-wrapping versions (v0.1) accumulated in u64/u128 and folded
## with `% 2^N`; the emitted values are identical.

pub fun fnv1a32(data: []const u8) -> u32 {
    # FNV-1a offset basis 2166136261; each byte XORs in then multiplies
    # with `*%` (mod-2^32 wrap, matching the canonical 32-bit FNV).
    var hash: u32 = 2166136261;
    var i: usize = 0;
    while (i < data.len) {
        hash = (hash ^ (data[i] as u32)) *% 16777619;
        i = i + 1;
    }
    return hash;
}

pub fun fnv1a64(data: []const u8) -> u64 {
    # 64-bit FNV: same structure, u64 state with `*%` wrapping.
    var hash: u64 = 14695981039346656037;
    var i: usize = 0;
    while (i < data.len) {
        hash = (hash ^ (data[i] as u64)) *% 1099511628211;
        i = i + 1;
    }
    return hash;
}

## CRC-32 (IEEE 802.3, reflected polynomial 0xEDB88320). Bitwise
## implementation — no table needed. All state is u32; the xor-into-
## and-shift steps stay in range (>> 1 discards the low bit as the
## reflection requires).
pub fun crc32(data: []const u8) -> u32 {
    var crc: u32 = 0xFFFFFFFF;
    var i: usize = 0;
    while (i < data.len) {
        crc = crc ^ (data[i] as u32);
        var bit: usize = 0;
        while (bit < 8) {
            if (crc & 1 != 0) {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc = crc >> 1;
            }
            bit = bit + 1;
        }
        i = i + 1;
    }
    return crc ^ 0xFFFFFFFF;
}

## SHA-256 (FIPS 180-4). Returns the 32-byte digest by value.
## All state variables are u32 and every add is `+%` — SHA-256
## defines all admits mod 2^32, so the wrapping operators express
## the spec directly (the v0.1 u64+modulo-fold form was the same
## arithmetic written awkwardly).
pub fun sha256(data: []const u8) -> [32]u8 {
    var h0: u32 = 0x6a09e667;
    var h1: u32 = 0xbb67ae85;
    var h2: u32 = 0x3c6ef372;
    var h3: u32 = 0xa54ff53a;
    var h4: u32 = 0x510e527f;
    var h5: u32 = 0x9b05688c;
    var h6: u32 = 0x1f83d9ab;
    var h7: u32 = 0x5be0cd19;

    let msg_len: usize = data.len;
    let bit_len: usize = msg_len * 8;
    let pad_len: usize = ((msg_len + 8) / 64 + 1) * 64;
    var msg: [128]u8 = undefined;
    if (pad_len > 128) { __zag_panic("std.hash.sha256: input too large"); }
    var i: usize = 0;
    while (i < msg_len) {
        msg[i] = data[i];
        i = i + 1;
    }
    msg[msg_len] = 0x80;
    var j: usize = msg_len + 1;
    while (j < pad_len - 8) {
        msg[j] = 0;
        j = j + 1;
    }
    # The bit-length (big-endian, 8 bytes) — shift by the literal 8
    # each round: zig 0.16 requires shift amounts to be Log2Int (u6
    # for u64), which a variable `k * 8` expression can't satisfy.
    var bl: usize = bit_len;
    var k: usize = 0;
    while (k < 8) {
        msg[pad_len - 1 - k] = bl as u8;
        bl = bl >> 8;
        k = k + 1;
    }

    const K: [64]u32 = [64]u32 {
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    };

    var chunk: usize = 0;
    while (chunk < pad_len) {
        var w: [64]u32 = undefined;
        var t: usize = 0;
        while (t < 16) {
            let b0: u32 = msg[chunk + t * 4] as u32;
            let b1: u32 = msg[chunk + t * 4 + 1] as u32;
            let b2: u32 = msg[chunk + t * 4 + 2] as u32;
            let b3: u32 = msg[chunk + t * 4 + 3] as u32;
            w[t] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
            t = t + 1;
        }
        while (t < 64) {
            let x: u32 = w[t - 15];
            let y: u32 = w[t - 2];
            let s0: u32 = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3);
            let s1: u32 = rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10);
            # Message-schedule adds are mod-2^32 (the u32 `+%` wrap).
            w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1;
            t = t + 1;
        }

        var a: u32 = h0;
        var b: u32 = h1;
        var c: u32 = h2;
        var d: u32 = h3;
        var e: u32 = h4;
        var f: u32 = h5;
        var g: u32 = h6;
        var h: u32 = h7;

        var r: usize = 0;
        while (r < 64) {
            let e1: u32 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            let ch: u32 = (e & f) ^ ((~e) & g);
            let temp1: u32 = h +% e1 +% ch +% K[r] +% w[r];
            let a0: u32 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            let maj: u32 = (a & b) ^ (a & c) ^ (b & c);
            let temp2: u32 = a0 +% maj;
            h = g;
            g = f;
            f = e;
            e = d +% temp1;
            d = c;
            c = b;
            b = a;
            a = temp1 +% temp2;
            r = r + 1;
        }

        h0 = h0 +% a;
        h1 = h1 +% b;
        h2 = h2 +% c;
        h3 = h3 +% d;
        h4 = h4 +% e;
        h5 = h5 +% f;
        h6 = h6 +% g;
        h7 = h7 +% h;
        chunk = chunk + 64;
    }

    return [32]u8 {
        ((h0 >> 24) % 256) as u8, ((h0 >> 16) % 256) as u8, ((h0 >> 8) % 256) as u8, (h0 % 256) as u8,
        ((h1 >> 24) % 256) as u8, ((h1 >> 16) % 256) as u8, ((h1 >> 8) % 256) as u8, (h1 % 256) as u8,
        ((h2 >> 24) % 256) as u8, ((h2 >> 16) % 256) as u8, ((h2 >> 8) % 256) as u8, (h2 % 256) as u8,
        ((h3 >> 24) % 256) as u8, ((h3 >> 16) % 256) as u8, ((h3 >> 8) % 256) as u8, (h3 % 256) as u8,
        ((h4 >> 24) % 256) as u8, ((h4 >> 16) % 256) as u8, ((h4 >> 8) % 256) as u8, (h4 % 256) as u8,
        ((h5 >> 24) % 256) as u8, ((h5 >> 16) % 256) as u8, ((h5 >> 8) % 256) as u8, (h5 % 256) as u8,
        ((h6 >> 24) % 256) as u8, ((h6 >> 16) % 256) as u8, ((h6 >> 8) % 256) as u8, (h6 % 256) as u8,
        ((h7 >> 24) % 256) as u8, ((h7 >> 16) % 256) as u8, ((h7 >> 8) % 256) as u8, (h7 % 256) as u8,
    };
}

## Rotate right. zig 0.16 requires Log2Int shift amounts (u5 for a
## u32 operand) — a u6 shift is rejected — so both shift slots are
## checked-cast into the u5 domain. `32 - n` is computed in u6 (32
## fits u6) then cast; every call site passes n in 2..25, so the
## checked cast never fires. No mask needed: u32 rotates cannot set
## bits above bit 31.
fun rotr(x: u32, n: u6) -> u32 {
    return (x >> (n as u5)) | (x << ((32 - n) as u5));
}
